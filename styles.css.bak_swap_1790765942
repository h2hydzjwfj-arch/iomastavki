/* ============================================================
   ФОРМА ЗАЯВКИ — ФИНАЛЬНАЯ ВЕРСИЯ (без дубликатов)
   ============================================================ */

#requestView.view-layer{
  padding:24px;
  align-items:center;
  justify-content:center;
  overflow:auto;
}
.request-shell{
  width:min(1180px, calc(100vw - 48px));
  max-width:1180px;
  margin:auto;
  padding:28px 36px 24px;
  border-radius:24px;
  background:#ffffff;
  border:1px solid rgba(31,84,118,.10);
  box-shadow:0 30px 90px rgba(24,70,98,.28);
}
html.dark .request-shell{
  background:#0b2238;
  border-color:rgba(140,200,225,.16);
}

.request-head{ text-align:center; margin-bottom:18px; }
.request-head .eyebrow{
  display:block; font-size:10px; letter-spacing:.18em;
  font-weight:700; text-transform:uppercase; color:#12897f; margin-bottom:6px;
}
html.dark .request-head .eyebrow{ color:#4fd1c5; }
.request-head h2{
  margin:4px 0 6px; font-size:24px; font-weight:650; letter-spacing:-.03em;
  color:#0f2a3f;
}
html.dark .request-head h2{ color:#e8f3f8; }
.request-head p{ margin:0; font-size:13px; color:#647f91; }
html.dark .request-head p{ color:#8eaabb; }

.request-form{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:14px 16px;
}
.request-form > label{
  display:flex; flex-direction:column; gap:6px;
  font-size:12px; font-weight:600; color:#37566b;
}
html.dark .request-form > label{ color:#bcd2de; }
.request-form > label:nth-of-type(5),
.request-form > label:nth-of-type(6),
.request-form > label:nth-of-type(7),
.request-form > label:nth-of-type(8),
.request-form > label:nth-of-type(9),
.request-form > .request-row-2,
.request-form > .request-row-dims{
  grid-column:1 / -1;
}

.request-form input,
.request-form textarea,
.request-form select{
  width:100%; padding:11px 14px;
  font:inherit; font-size:14px;
  border:1.5px solid rgba(31,84,118,.16);
  border-radius:10px;
  background:#ffffff;
  color:#0f2a3f;
  outline:none;
  box-sizing:border-box;
  transition:border-color .15s, box-shadow .15s;
}
html.dark .request-form input,
html.dark .request-form textarea,
html.dark .request-form select{
  background:rgba(255,255,255,.05);
  border-color:rgba(140,200,225,.20);
  color:#e8f3f8;
}
.request-form input:focus,
.request-form textarea:focus{
  border-color:#12897f;
  box-shadow:0 0 0 3px rgba(20,156,148,.15);
}
.request-form textarea{ min-height:70px; max-height:90px; resize:vertical; }

.request-form .calculate{
  grid-column:1 / -1;
  height:46px; margin-top:4px; width:100%;
  border:0; border-radius:12px;
  background:linear-gradient(135deg, #2a76a6 0%, #2f95b8 55%, #2aa8a6 120%);
  color:#fff; font-size:15px; font-weight:650;
  cursor:pointer;
  box-shadow:0 10px 24px rgba(37,111,159,.28);
}
.request-status{
  grid-column:1 / -1; text-align:center;
  font-size:14px; min-height:20px;
  color:#647f91;
}
.request-status.is-ok{ color:#1b7f57; font-weight:600; }
.request-status.is-error{ color:#b93c35; font-weight:600; }
html.dark .request-status{ color:#8eaabb; }
html.dark .request-status.is-ok{ color:#5fd6a4; }
html.dark .request-status.is-error{ color:#ff8f86; }

.request-row-2{ display:grid; grid-template-columns:1fr 1fr; gap:14px; }

/* ---- КОНТАКТ: селектор страны + телефон ---- */
.phone-field{
  position:relative;
  display:flex;
  gap:8px;
  align-items:stretch;
}
.phone-country-btn{
  flex:0 0 auto;
  display:inline-flex;
  align-items:center;
  gap:6px;
  padding:11px 14px;
  border:1.5px solid rgba(31,84,118,.16);
  border-radius:10px;
  background:#ffffff;
  color:#0f2a3f;
  font:inherit;
  font-size:14px;
  font-weight:600;
  cursor:pointer;
}
html.dark .phone-country-btn{
  background:rgba(255,255,255,.05);
  border-color:rgba(140,200,225,.20);
  color:#e8f3f8;
}
.phone-flag{ font-size:18px; }
.phone-code{ font-variant-numeric:tabular-nums; }
.phone-chevron{ width:14px; height:14px; color:#647f91; transition:transform .2s; }
.phone-country-btn[aria-expanded="true"] .phone-chevron{ transform:rotate(180deg); }

/* DROPDOWN СТРАН — непрозрачный, читаемый */
.phone-dropdown{
  position:absolute;
  top:calc(100% + 6px);
  left:0;
  right:0;
  z-index:1000;
  display:flex;
  flex-direction:column;
  max-height:min(360px, 60vh);
  background:#ffffff;
  border:1.5px solid rgba(31,84,118,.22);
  border-radius:14px;
  box-shadow:0 24px 60px rgba(15,42,63,.35);
  overflow:hidden;
}
html.dark .phone-dropdown{
  background:#0d2b45;
  border-color:rgba(140,200,225,.28);
}
.phone-dropdown.hidden{ display:none; }

.phone-search-wrap{
  position:relative;
  flex:0 0 auto;
  padding:10px 12px;
  border-bottom:1px solid rgba(31,84,118,.11);
  background:#ffffff;
}
html.dark .phone-search-wrap{
  background:#0d2b45;
  border-bottom-color:rgba(140,200,225,.14);
}
.phone-search-icon{
  position:absolute; left:22px; top:50%;
  transform:translateY(-50%);
  width:16px; height:16px;
  color:#647f91;
  pointer-events:none;
}
.phone-search-wrap input{
  width:100%;
  padding:10px 12px 10px 38px;
  background:rgba(15,42,63,.04);
  border:1px solid rgba(31,84,118,.14);
  border-radius:10px;
  color:#0f2a3f;
  font-size:14px;
  outline:none;
}
html.dark .phone-search-wrap input{
  background:rgba(255,255,255,.06);
  border-color:rgba(140,200,225,.20);
  color:#e8f3f8;
}
.phone-list{
  flex:1 1 auto;
  min-height:0;
  overflow-y:auto;
  padding:6px;
}
.phone-item{
  display:flex;
  align-items:center;
  gap:10px;
  width:100%;
  padding:10px 12px;
  border:0;
  border-radius:8px;
  background:transparent;
  color:#0f2a3f;
  font-size:14px;
  text-align:left;
  cursor:pointer;
}
html.dark .phone-item{ color:#e8f3f8; }
.phone-item:hover, .phone-item.active{ background:rgba(20,156,148,.12); }
html.dark .phone-item:hover, html.dark .phone-item.active{ background:rgba(79,209,197,.18); }
.phone-item-flag{ font-size:20px; }
.phone-item-name{ flex:1; font-weight:500; }
.phone-item-code{
  color:#647f91;
  font-weight:600;
  font-variant-numeric:tabular-nums;
}
html.dark .phone-item-code{ color:#8eaabb; }
.phone-empty{
  padding:24px 16px;
  text-align:center;
  color:#647f91;
  font-size:14px;
}

/* ---- INCOTERMS и ТРАНЗИТ ---- */
.incoterm-picker, .transit-picker{ position:relative; grid-column:1 / -1; }
.incoterm-btn{
  width:100%;
  min-height:44px;
  display:grid;
  grid-template-columns:auto 1fr auto;
  gap:12px;
  align-items:center;
  padding:10px 14px;
  border:1.5px solid rgba(31,84,118,.16);
  border-radius:10px;
  background:#ffffff;
  color:#0f2a3f;
  font:inherit;
  text-align:left;
  cursor:pointer;
}
html.dark .incoterm-btn{
  background:rgba(255,255,255,.05);
  border-color:rgba(140,200,225,.20);
  color:#e8f3f8;
}
.incoterm-value{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-width:54px;
  padding:6px 12px;
  border-radius:8px;
  background:linear-gradient(135deg, #2a76a6 0%, #2f95b8 55%, #2aa8a6 120%);
  color:#fff;
  font-size:13px;
  font-weight:700;
  letter-spacing:.03em;
}
.incoterm-hint{
  font-size:13px;
  color:#647f91;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}
html.dark .incoterm-hint{ color:#8eaabb; }
.incoterm-chev{ width:16px; height:16px; color:#647f91; transition:transform .2s; }
.incoterm-btn[aria-expanded="true"] .incoterm-chev{ transform:rotate(180deg); }

.incoterm-dropdown{
  position:absolute;
  top:calc(100% + 6px);
  left:0;
  right:0;
  z-index:1000;
  max-height:min(320px, 55vh);
  overflow-y:auto;
  padding:6px;
  background:#ffffff;
  border:1.5px solid rgba(31,84,118,.22);
  border-radius:12px;
  box-shadow:0 24px 60px rgba(15,42,63,.35);
}
html.dark .incoterm-dropdown{
  background:#0d2b45;
  border-color:rgba(140,200,225,.28);
}
.incoterm-dropdown.hidden{ display:none; }
.incoterm-item{
  display:grid;
  grid-template-columns:70px 1fr;
  gap:10px;
  align-items:center;
  width:100%;
  padding:10px 12px;
  border:0;
  border-radius:8px;
  background:transparent;
  color:#0f2a3f;
  font:inherit;
  font-size:14px;
  text-align:left;
  cursor:pointer;
}
html.dark .incoterm-item{ color:#e8f3f8; }
.incoterm-item:hover{ background:rgba(20,156,148,.12); }
html.dark .incoterm-item:hover{ background:rgba(79,209,197,.18); }
.incoterm-item b{
  font-size:14px; font-weight:700; color:#12897f; letter-spacing:.03em;
}
html.dark .incoterm-item b{ color:#4fd1c5; }
.incoterm-item small{ font-size:12px; color:#647f91; }
html.dark .incoterm-item small{ color:#8eaabb; }

/* ---- ГАБАРИТЫ И ВЕС ---- */
.input-with-suffix{
  position:relative;
  display:flex;
  align-items:center;
}
.input-with-suffix input{ padding-right:52px; font-variant-numeric:tabular-nums; }
.input-with-suffix .suffix{
  position:absolute;
  right:14px;
  top:50%;
  transform:translateY(-50%);
  font-size:13px;
  font-weight:600;
  color:#647f91;
  pointer-events:none;
}
html.dark .input-with-suffix .suffix{ color:#8eaabb; }

.request-row-dims{
  display:grid;
  grid-template-columns:1fr auto 1fr auto 1fr;
  gap:8px;
  align-items:center;
}
.dim-sep{
  font-size:16px;
  font-weight:600;
  color:#647f91;
  text-align:center;
  user-select:none;
}
.unit-switch{
  display:inline-flex;
  gap:2px;
  margin-top:8px;
  padding:3px;
  border-radius:999px;
  background:rgba(15,42,63,.06);
}
html.dark .unit-switch{ background:rgba(255,255,255,.06); }
.unit-choice{
  height:26px; min-width:44px;
  padding:0 12px;
  border:0;
  border-radius:999px;
  background:transparent;
  color:#37566b;
  font-size:12px;
  font-weight:600;
  cursor:pointer;
}
html.dark .unit-choice{ color:#bcd2de; }
.unit-choice.active{
  background:#ffffff;
  color:#256f9f;
  box-shadow:0 1px 3px rgba(15,42,63,.10);
}
html.dark .unit-choice.active{
  background:rgba(255,255,255,.10);
  color:#6fe0d5;
}
.optional{ font-weight:400; color:#647f91; font-size:12px; }

/* Мобильный */
@media (max-width:700px){
  .request-form{ grid-template-columns:1fr; }
  .request-shell{ width:100vw; max-width:100vw; padding:20px 16px; border-radius:0; }
}


