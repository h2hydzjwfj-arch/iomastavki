.meteor{
  position:absolute;
  width:2.5px;
  height:140px;
  background:linear-gradient(180deg,
    rgba(255,255,255,0) 0%,
    rgba(200,225,255,.5) 30%,
    #ffffff 85%,
    #e8f4ff 100%);
  border-radius:3px;
  filter:
    drop-shadow(0 0 4px #fff)
    drop-shadow(0 0 10px rgba(140,200,255,.9))
    drop-shadow(0 0 22px rgba(100,170,255,.55));
  transform-origin:top center;
  transform:rotate(35deg);
  opacity:0;
  animation:meteorFall 2.4s cubic-bezier(.35,0,.65,1) forwards;
}
@keyframes meteorFall{
  0%   { opacity:0; transform:rotate(35deg) translateY(-10vh) scaleY(.4); }
  8%   { opacity:1; }
  25%  { opacity:1; transform:rotate(35deg) translateY(15vh) scaleY(1); }
  75%  { opacity:1; transform:rotate(35deg) translateY(70vh) scaleY(1); }
  100% { opacity:0; transform:rotate(35deg) translateY(115vh) scaleY(.7); }
}


