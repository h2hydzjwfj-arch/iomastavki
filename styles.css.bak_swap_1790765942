.customs-form .calculate { flex: 0 0 auto; height: 50px; }
.customs-status { min-height: 22px; margin: 12px 2px 0; font-size: 14px; color: var(--muted); }
.customs-result { margin-top: 10px; animation: rise .4s var(--ease) backwards; }
.customs-result-title { margin: 6px 0 12px; font-size: var(--fs-lg); line-height: var(--lh-snug); font-weight: 650; letter-spacing: -.02em; }
.customs-result-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
.customs-info-card { padding: 12px 14px; border: 1px solid var(--line); border-radius: var(--r-md); background: var(--chip); }
.customs-info-label { margin-bottom: 3px; font-size: var(--fs-2xs); font-weight: 700; letter-spacing: .08em; color: var(--muted); }
.customs-info-value { font-size: var(--fs-base); line-height: 1.5; overflow-wrap: anywhere; }
