/* 12. TAROT ("Карта дня") -------------------------------------------------- */
.tarot-shell { position: absolute; inset: 0; display: grid; place-items: center; padding: 24px; overflow: hidden; }
.tarot-shell .close-button { position: absolute; top: 14px; right: 14px; margin: 0; align-self: auto; z-index: 5; }
.tarot-dust-canvas { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
.tarot-particles { display: none; }

.tarot-card {
  position: relative;
  width: min(380px, 88vw); min-height: 540px;
  padding: 44px 32px 36px;
  display: flex; flex-direction: column; align-items: center;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, .22); border-radius: 30px;
  background: radial-gradient(140% 100% at 50% -10%, rgba(120, 170, 200, .18), transparent 55%), linear-gradient(160deg, #0e2c44 0%, #163f5c 46%, #0a2032 100%);
  box-shadow: 0 40px 100px rgba(4, 14, 24, .5), inset 0 1px 0 rgba(255, 255, 255, .22);
  color: #fdfbf4; text-align: center;
  opacity: 0;
  perspective: 1200px;
  transform-style: preserve-3d;
}
.tarot-card::before {
  content: ""; position: absolute; inset: 10px; border-radius: 22px;
  border: 1px solid rgba(230, 200, 140, .35);
  -webkit-mask: linear-gradient(#000, #000);
  pointer-events: none;
}
.tarot-card::after {
  /* slow light sweep across the card face, like satin catching light */
  content: ""; position: absolute; top: -40%; left: -60%; width: 60%; height: 180%;
  background: linear-gradient(75deg, transparent, rgba(255, 244, 214, .16) 45%, rgba(255, 244, 214, .28) 50%, rgba(255, 244, 214, .16) 55%, transparent);
  transform: rotate(8deg);
  animation: tarotSheen 7s ease-in-out 1.4s infinite;
  pointer-events: none;
}
.tarot-shell.tarot-ready .tarot-card { animation: tarotFlipIn .85s cubic-bezier(.2, .8, .2, 1) .25s both; }
.tarot-shell.tarot-closing .tarot-card { animation: tarotOut .4s cubic-bezier(.4,0,.8,.4) both; }

.tarot-seal { position: relative; width: 128px; height: 128px; margin-bottom: 22px; flex: 0 0 auto; }
.tarot-seal-ring, .tarot-seal-rays { position: absolute; inset: 0; width: 100%; height: 100%; fill: none; }
.tarot-seal-ring circle { stroke: rgba(230, 200, 140, .55); stroke-width: 1; }
.tarot-seal-ring { animation: tarotSpin 60s linear infinite; }
.tarot-seal-rays { stroke: rgba(230, 200, 140, .4); stroke-width: 1.4; stroke-linecap: round; animation: tarotSpin 90s linear infinite reverse; }
.tarot-seal::before {
  content: ""; position: absolute; inset: 14%; border-radius: 50%;
  background: radial-gradient(circle at 40% 32%, rgba(255, 250, 225, .95), rgba(230, 195, 140, .35) 55%, transparent 78%);
  filter: blur(.5px);
  animation: tarotGlow 4.5s ease-in-out infinite;
}
.tarot-symbol {
  position: absolute; inset: 0; display: grid; place-items: center;
  font-size: 44px; line-height: 1; font-weight: 600; font-family: Georgia, "Times New Roman", serif;
  color: #fffaf0; text-shadow: 0 0 22px rgba(255, 235, 190, .8), 0 0 3px rgba(255, 255, 255, .9);
}
.tarot-roman { position: absolute; bottom: -6px; left: 50%; transform: translateX(-50%); font-size: 10px; letter-spacing: .18em; color: rgba(230, 210, 175, .75); }

.tarot-label { font-size: var(--fs-2xs); letter-spacing: .32em; text-transform: uppercase; color: rgba(230, 210, 175, .8); }
.tarot-card h2 { margin: 14px 0 6px; font-family: Georgia, "Times New Roman", serif; font-size: 30px; font-weight: 500; letter-spacing: .01em; }
.tarot-keyword {
  display: inline-flex; align-items: center; gap: 8px;
  margin-bottom: 16px; padding: 5px 16px;
  border: 1px solid rgba(230, 200, 140, .35); border-radius: 999px;
  font-size: 12.5px; letter-spacing: .08em; text-transform: uppercase; color: #f3e2bb;
}
.tarot-card p { max-width: 280px; margin: 0 auto; font-size: 15px; line-height: 1.75; color: rgba(253, 251, 244, .88); }
.tarot-meta { margin-top: auto; padding-top: 22px; font-size: var(--fs-2xs); letter-spacing: .08em; color: rgba(230, 210, 175, .6); }

@keyframes tarotFlipIn {
  0%   { opacity: 0; transform: rotateY(-100deg) scale(.92); }
  55%  { opacity: 1; }
  100% { opacity: 1; transform: rotateY(0deg) scale(1); }
}
@keyframes tarotOut { to { opacity: 0; transform: rotateY(70deg) scale(.94); } }
@keyframes tarotSpin { to { transform: rotate(360deg); } }
@keyframes tarotGlow { 0%, 100% { opacity: .75; transform: scale(.97); } 50% { opacity: 1; transform: scale(1.05); } }
@keyframes tarotSheen { 0%, 100% { transform: translateX(0) rotate(8deg); opacity: 0; } 8% { opacity: 1; } 45% { transform: translateX(260%) rotate(8deg); opacity: 0; } }
@media (prefers-reduced-motion: reduce) {
  .tarot-seal-ring, .tarot-seal-rays, .tarot-seal::before, .tarot-card::after { animation: none; }
}

/* 13. TOASTS, SKELETONS, STATES ------------------------------------------- */
.toast-host {
  position: fixed; left: 50%; bottom: calc(20px + var(--safe-b)); z-index: 1200;
  display: flex; flex-direction: column; align-items: center; gap: 8px;
  width: min(440px, calc(100vw - 32px));
  transform: translateX(-50%);
  pointer-events: none;
}
.toast {
  display: flex; align-items: center; gap: 10px;
  max-width: 100%; padding: 12px 16px;
  border-radius: var(--r-lg);
  background: #0d2b45; color: #fff;
  font-size: 14px; line-height: 1.4;
  box-shadow: var(--shadow-lg);
  pointer-events: auto;
  animation: toastIn .4s var(--ease) backwards;
}
html.dark .toast { background: #1c4468; }
.toast .ico { width: 20px; height: 20px; margin: 0; }
.toast-success .ico { color: #5fe0c0; }
.toast-error .ico { color: #ff9a90; }
.toast-info .ico { color: #86c8ee; }
.toast.out { animation: toastOut .28s ease-in forwards; }
@keyframes toastIn { from { opacity: 0; transform: translate3d(0, 16px, 0) scale(.96); } to { opacity: 1; transform: none; } }
@keyframes toastOut { to { opacity: 0; transform: translate3d(0, 8px, 0) scale(.97); } }

.skeleton { border-radius: 8px; background: linear-gradient(90deg, var(--chip) 25%, var(--chip-hover) 50%, var(--chip) 75%); background-size: 200% 100%; animation: shimmer 1.4s linear infinite; }
@keyframes shimmer { to { background-position: -200% 0; } }

.empty-state { display: grid; justify-items: center; gap: 6px; padding: 40px 20px; text-align: center; color: var(--muted); font-size: 14px; }

