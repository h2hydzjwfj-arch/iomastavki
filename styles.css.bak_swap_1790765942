  box-shadow: var(--btn-shadow);
  cursor: pointer;
  transition: transform var(--t-fast) var(--ease), filter var(--t-fast);
}
.article-audio-btn:active { transform: scale(.96); }
.article-audio-btn .audio-pause-icon, .article-audio-btn .audio-orb-mini { display: none; }
.article-audio-btn.playing .audio-play-icon { display: none; }
