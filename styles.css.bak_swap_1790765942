.audio-orb-mini i { width: 3px; height: 100%; border-radius: 2px; background: rgba(255, 255, 255, .85); transform-origin: bottom; animation: eq .9s ease-in-out infinite; }
.audio-orb-mini i:nth-child(2) { animation-delay: .2s; }
.audio-orb-mini i:nth-child(3) { animation-delay: .4s; }
@keyframes eq { 0%, 100% { transform: scaleY(.3); } 50% { transform: scaleY(1); } }
@media (hover: hover) { .article-audio-btn:hover { filter: brightness(1.07); } }

.article-inline-progress { height: 3px; margin: 22px 0 18px; overflow: hidden; border-radius: 2px; background: var(--line); }
.article-inline-progress > div { width: 34%; height: 100%; border-radius: 2px; background: var(--teal); animation: artProg 1.3s ease-in-out infinite; }
@keyframes artProg { from { transform: translateX(-100%); } to { transform: translateX(300%); } }
.article-skeleton { display: grid; gap: 10px; }
.article-skeleton .skeleton { height: 14px; }
.article-skeleton .skeleton:nth-child(4n) { width: 70%; margin-bottom: 14px; }
.article-error { padding: 20px; text-align: center; color: var(--danger); }

.article-source-link { margin-top: 30px; padding-top: 16px; border-top: 1px solid var(--line); font-size: 14px; line-height: 1.5; color: var(--muted); }
