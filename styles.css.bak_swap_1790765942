.article-title h1 { margin: 0 0 10px; max-width: 900px; font-size: clamp(28px, 3.6vw, 46px); line-height: 1.14; font-weight: 700; letter-spacing: -.035em; color: #fff; text-shadow: 0 2px 22px rgba(0, 0, 0, .45); }
.article-meta { font-size: var(--fs-sm); color: rgba(255, 255, 255, .84); }
.article-credit { position: absolute; right: 16px; bottom: 10px; font-size: var(--fs-2xs); color: rgba(255, 255, 255, .6); }

.article-layout { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 56px; align-items: start; max-width: 1140px; margin: 0 auto; padding: 40px 40px 80px; }
.article-layout:not(:has(.article-aside)) { grid-template-columns: minmax(0, 1fr); max-width: 780px; }
.article-body { width: 100%; max-width: none; margin: 0; padding: 0; font-size: 18px; line-height: var(--lh-read); }
