.news-card-img { position: relative; flex: 0 0 auto; height: 168px; overflow: hidden; background: linear-gradient(135deg, var(--blue-soft), var(--teal-soft)); }
.news-card-img img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .7s var(--ease); }
