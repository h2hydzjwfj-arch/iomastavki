@media (hover: hover) { .article-back:hover { background: rgba(6, 20, 34, .66); } }
.article-title { position: absolute; left: 0; right: 0; bottom: 0; padding: 28px max(40px, calc(50% - 540px)) 34px; color: #fff; }
.article-badges { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
.badge {
  display: inline-flex; align-items: center; height: 26px; padding: 0 12px; border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, .24); background: rgba(255, 255, 255, .16); color: #fff;
  font-size: var(--fs-xs); font-weight: 650; letter-spacing: .01em;
