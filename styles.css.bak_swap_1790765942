.currency-item b { color: var(--ink); font-weight: 650; }
.currency-source { font-size: var(--fs-2xs); color: var(--faint); }

/* directory ---------------------------------------------------------------- */
.directory-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 14px 24px; margin-bottom: 18px; }
.directory-filters { display: flex; flex-wrap: wrap; gap: 6px; }
.directory-filter {
  height: 34px; padding: 0 15px;
  border: 1px solid var(--line); border-radius: 999px;
  background: var(--chip); color: var(--ink-2);
  font-size: var(--fs-sm); font-weight: 600;
  cursor: pointer;
  transition: background var(--t-base) var(--ease), color var(--t-fast), transform var(--t-fast) var(--ease), border-color var(--t-fast);
}
.directory-filter:active { transform: scale(.94); }
.directory-filter.active { border-color: transparent; background: var(--btn); color: #fff; box-shadow: 0 4px 12px rgba(37, 111, 159, .25); }
@media (hover: hover) { .directory-filter:not(.active):hover { background: var(--chip-hover); } }

.directory-table-wrap { flex: 1; min-height: 0; overflow: auto; overscroll-behavior: contain; border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--popover); }
.directory-table { width: 100%; min-width: 1040px; border-collapse: separate; border-spacing: 0; font-size: 13.5px; line-height: 1.5; }
.directory-table th {
  position: sticky; top: 0; z-index: 2;
  padding: 12px 16px;
  border-bottom: 1px solid var(--line);
  background: var(--thead);
  text-align: left; white-space: nowrap;
  font-size: var(--fs-xs); font-weight: 600; color: var(--muted);
}
.directory-table td { padding: 14px 16px; vertical-align: top; border-bottom: 1px solid var(--line); overflow-wrap: break-word; }
.directory-table td:nth-child(3), .directory-table td:nth-child(4), .directory-table td:nth-child(5) { white-space: nowrap; }
.directory-table tbody tr:last-child td { border-bottom: 0; }
.directory-table td:first-child { font-size: 14px; }
.directory-table a { color: var(--blue); text-decoration: none; }
.directory-table a:hover { text-decoration: underline; text-underline-offset: 3px; }
@media (hover: hover) { .directory-table tbody tr:hover td { background: var(--row-hover); } }
.directory-table .empty-cell { padding: 48px 16px; text-align: center; color: var(--muted); }

/* 8. ASSISTANT ------------------------------------------------------------- */
.assistant-head { margin-bottom: 8px; }

.voice-orb-stage { flex: 0 0 auto; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 0; overflow: hidden; transition: height .5s var(--ease-sheet); }
#assistantView.voice-active .voice-orb-stage { height: clamp(240px, 42vh, 340px); }
.voice-orb { position: relative; width: 260px; height: 260px; max-width: 100%; border-radius: 50%; background: none; box-shadow: none; -webkit-tap-highlight-color: transparent; }
.voice-orb > span { display: none; }
.voice-orb-canvas { display: block; width: 100%; height: 100%; }
.voice-orb-caption { margin-top: -6px; min-height: 22px; font-size: 15px; font-weight: 600; letter-spacing: -.01em; color: var(--ink-2); }
.voice-exit { margin-top: 4px; padding: 6px 14px; border: 0; border-radius: 999px; background: transparent; color: var(--muted); font-size: var(--fs-xs); font-weight: 600; cursor: pointer; transition: background var(--t-fast), color var(--t-fast); }
@media (hover: hover) { .voice-exit:hover { background: var(--chip); color: var(--ink); } }
#assistantView.voice-active .assistant-head small { display: none; }
#assistantView.voice-session .chat-messages { max-height: 26vh; }

.chat-messages {
  flex: 1; min-height: 0;
  display: flex; flex-direction: column; gap: 10px;
  padding: 6px 2px 12px;
  overflow-y: auto; overscroll-behavior: contain;
}
.chat-bubble {
  max-width: min(84%, 640px);
  padding: 11px 15px;
  border-radius: 20px;
  font-size: var(--fs-base); line-height: 1.55;
  white-space: pre-wrap; overflow-wrap: anywhere;
  animation: bubbleIn .35s var(--ease) backwards;
}
.chat-bubble.user { align-self: flex-end; border-bottom-right-radius: 6px; background: var(--btn); color: #fff; }
.chat-bubble.assistant { align-self: flex-start; border: 1px solid var(--line); border-bottom-left-radius: 6px; background: var(--chip); }
.ai-thinking-bubble { display: flex; align-items: center; gap: 5px; min-height: 44px; }
.ai-thinking-bubble i { width: 7px; height: 7px; border-radius: 50%; background: var(--faint); animation: thinkingDot 1.2s ease-in-out infinite; }
.ai-thinking-bubble i:nth-child(2) { animation-delay: .15s; }
.ai-thinking-bubble i:nth-child(3) { animation-delay: .3s; }
.ai-think-text { margin-left: 8px; font-size: 13.5px; color: var(--muted); animation: rise .35s var(--ease) backwards; }
.chat-bubble.streaming::after { content: ""; display: inline-block; width: 7px; height: 15px; margin-left: 3px; vertical-align: -2px; border-radius: 2px; background: var(--teal); animation: pulse 1s ease-in-out infinite; }
.chat-bubble .li { display: block; padding-left: 2px; }
.chat-bubble code { padding: 1px 6px; border-radius: 6px; background: var(--chip-hover); font-size: .92em; }
.ai-error-bubble { border-color: transparent; background: var(--danger-soft); color: var(--danger); }
@keyframes bubbleIn { from { opacity: 0; transform: translate3d(0, 10px, 0) scale(.98); } to { opacity: 1; transform: none; } }
@keyframes thinkingDot { 50% { transform: translateY(-4px); opacity: .45; } }

.chat-empty { margin: auto; max-width: 480px; padding: 12px; text-align: center; animation: rise .5s var(--ease) backwards; }
.chat-empty-icon { display: grid; place-items: center; width: 48px; height: 48px; margin: 0 auto 12px; border-radius: 16px; background: var(--teal-soft); color: var(--teal); }
.chat-empty-icon svg { width: 26px; height: 26px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
.chat-empty h3 { font-size: var(--fs-lg); line-height: var(--lh-snug); font-weight: 650; letter-spacing: -.02em; }
.chat-empty p { margin-top: 6px; font-size: 14px; color: var(--muted); }
.chat-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 16px; }
.chat-chip {
  padding: 9px 14px;
  border: 1px solid var(--line); border-radius: 999px;
  background: var(--chip); color: var(--ink-2);
  font-size: 13.5px; line-height: 1.3;
  cursor: pointer;
  transition: background var(--t-fast), transform var(--t-fast) var(--ease), border-color var(--t-fast);
}
.chat-chip:active { transform: scale(.95); }
@media (hover: hover) { .chat-chip:hover { border-color: var(--teal); background: var(--teal-soft); color: var(--ink); } }

.voice-state { padding: 0 0 6px; text-align: center; font-size: var(--fs-xs); color: var(--muted); }
.chat-compose {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto auto auto;
  grid-template-areas: "ta ta ta ta" "fn tools mic send";
  gap: 10px;
  padding-top: 10px;
  border-top: 1px solid var(--line);
}
.attachment-row, .compose-actions { display: contents; }
#assistantInput { grid-area: ta; }
.file-names { grid-area: fn; align-self: center; }
/* attach + mic sit next to each other, both before Send */
.attachment-row .attach-button { grid-area: tools; }
.voice-button { grid-area: mic; }
.assistant-save { grid-area: send; min-width: 140px; }
.file-names { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--fs-xs); color: var(--muted); }
#assistantInput { min-height: 60px; max-height: 160px; }
.voice-button {
  width: 44px; height: 44px;
  display: grid; place-items: center; padding: 0;
  border: 0; border-radius: var(--r-md);
  background: var(--blue-soft); color: var(--blue);
  cursor: pointer;
  transition: background var(--t-fast), transform var(--t-fast) var(--ease), color var(--t-fast);
}
.voice-button:active { transform: scale(.92); }
.voice-button.listening { background: var(--danger-soft); color: var(--danger); animation: orbBreath 1.4s ease-in-out infinite; }
.mic-icon { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
#assistantStatus:empty { display: none; }
#assistantStatus { margin-top: 6px; font-size: var(--fs-xs); color: var(--muted); }

/* 9. NEWS ------------------------------------------------------------------ */
.news-shell { --pw: 1120px; }
.news-shell .directory-head { margin-bottom: 16px; }
.news-list {
  flex: 1; min-height: 0;
  display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); align-content: start; grid-auto-rows: max-content; gap: 16px;
  padding: 4px 4px 10px; margin: 0 -4px;
  overflow-y: auto; overscroll-behavior: contain;
}
.news-card {
  position: relative;
  display: flex; flex-direction: column;
  padding: 0; overflow: hidden;
  border: 1px solid var(--line); border-radius: var(--r-lg);
  background: var(--popover); color: inherit; text-align: left;
  box-shadow: var(--shadow-sm);
  cursor: pointer;
  content-visibility: auto; contain-intrinsic-size: auto 290px;
  animation: rise .5s var(--ease) backwards;
  animation-delay: calc(var(--i, 0) * 45ms);
  transition: transform var(--t-base) var(--ease), box-shadow var(--t-base) var(--ease), border-color var(--t-base);
}
