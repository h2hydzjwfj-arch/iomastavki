/* ==========================================================================
   IOMASTAVKA — styles.css  (v2 design system)
   Soft blue + teal on navy. macOS / iOS feel. No frameworks, no web fonts.

   Structure
     1. Tokens (light / dark)          8. Assistant (chat + voice)
     2. Base + typography              9. News
     3. Weather scene (background)    10. Article
     4. Topbar                        11. Customs
     5. Home                          12. Tarot
     6. Views + panels                13. Toasts, skeletons, states
     7. Forms + calculator            14. Responsive + accessibility
   Theme switch: <html class="dark"> (set before first paint) + body.manual-*.
   ========================================================================== */

/* 1. TOKENS ---------------------------------------------------------------- */
:root {
  color-scheme: light;

  --font: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif;

  /* type scale */
  --fs-2xs: 11px;
  --fs-xs: 12px;
  --fs-sm: 13px;
  --fs-base: 15px;
  --fs-md: 17px;
  --fs-lg: 20px;
  --fs-xl: 28px;
  --fs-hero: clamp(46px, 7vw, 68px);
  --lh-tight: 1.15;
  --lh-snug: 1.35;
  --lh-body: 1.6;
  --lh-read: 1.75;

  /* radius */
  --r-sm: 10px;
  --r-md: 14px;
  --r-lg: 20px;
  --r-xl: 28px;

  /* motion */
  --ease: cubic-bezier(.22, 1, .36, 1);
  --ease-sheet: cubic-bezier(.32, .72, 0, 1);
  --t-fast: .15s;
  --t-base: .3s;
  --t-slow: .5s;

  /* layout */
  --topbar-h: 64px;
  --safe-t: env(safe-area-inset-top, 0px);
  --safe-b: env(safe-area-inset-bottom, 0px);

  /* palette — light */
  --ink: #0f2a3f;
  --ink-2: #37566b;
  --muted: #647f91;
  --faint: #93a9b7;
  --navy: #0d2b45;
  --blue: #256f9f;
  --blue-2: #4a9cc6;
  --blue-soft: rgba(43, 120, 168, .10);
  --teal: #12897f;
  --teal-2: #2fb3a8;
  --teal-soft: rgba(20, 156, 148, .11);
  --danger: #b93c35;
  --danger-soft: rgba(201, 72, 63, .10);
  --warn: #9a6412;
  --warn-soft: rgba(217, 152, 40, .14);
  --ok: #1b7f57;

  --panel: rgba(252, 254, 255, .97);
  --panel-border: rgba(180, 208, 228, .55);
  --card: linear-gradient(140deg, rgba(255, 255, 255, .97), rgba(232, 245, 251, .84));
  --card-border: rgba(163, 199, 222, .55);
  --field: #fff;
  --field-border: rgba(31, 84, 118, .22);
  --chip: rgba(15, 42, 63, .07);
  --chip-hover: rgba(15, 42, 63, .12);
  --hover: rgba(255, 255, 255, .7);
  --line: rgba(31, 84, 118, .14);
  --line-strong: rgba(31, 84, 118, .26);
  --thead: #e9f3f9;
  --row-hover: rgba(43, 120, 168, .06);
  --scrim: rgba(13, 43, 69, .12);

  --btn: linear-gradient(135deg, #22699c 0%, #2790b3 55%, #1f9d92 120%);
  --btn-shadow: 0 8px 22px rgba(30, 100, 145, .34);

  /* a warm accent, used sparingly: featured/highlight touches, never the whole brand */
  --accent: #cc5a28;
  --accent-2: #e08a2e;
  --accent-soft: rgba(204, 90, 40, .12);

  --shadow-sm: 0 1px 2px rgba(15, 42, 63, .07), 0 4px 12px rgba(15, 42, 63, .07);
  --shadow-md: 0 2px 6px rgba(15, 42, 63, .06), 0 14px 36px rgba(24, 70, 98, .16);
  --shadow-lg: 0 30px 90px rgba(24, 70, 98, .28), 0 2px 8px rgba(15, 42, 63, .09);

  --sky-a: #bfe6f8;
  --sky-b: #e9f6fc;
  --sky-c: #f7fbfe;
  --focus: 0 0 0 3px rgba(20, 156, 148, .32);
}

html.dark {
  color-scheme: dark;

  --ink: #e8f3f8;
  --ink-2: #bcd2de;
  --muted: #8eaabb;
  --faint: #5f7f92;
  --navy: #071522;
  --blue: #63b0dc;
  --blue-2: #7cc0e6;
  --blue-soft: rgba(99, 176, 220, .14);
  --teal: #4fd1c5;
  --teal-2: #6fe0d5;
  --teal-soft: rgba(79, 209, 197, .13);
  --danger: #ff8f86;
  --danger-soft: rgba(255, 128, 118, .12);
  --warn: #f2c26b;
  --warn-soft: rgba(242, 194, 107, .12);
  --ok: #5fd6a4;

  --panel: rgba(11, 34, 56, .92);
  --panel-border: rgba(140, 200, 225, .16);
  --card: linear-gradient(140deg, rgba(20, 52, 80, .72), rgba(12, 36, 58, .62));
  --card-border: rgba(140, 200, 225, .16);
  --field: rgba(255, 255, 255, .05);
  --field-border: rgba(140, 200, 225, .20);
  --chip: rgba(255, 255, 255, .07);
  --chip-hover: rgba(255, 255, 255, .12);
  --hover: rgba(255, 255, 255, .07);
  --line: rgba(140, 200, 225, .12);
  --line-strong: rgba(140, 200, 225, .24);
  --thead: #0f2a44;
  --row-hover: rgba(99, 176, 220, .07);
  --scrim: rgba(2, 8, 18, .32);

  --btn: linear-gradient(135deg, #2b7fb5 0%, #2596b4 55%, #1fae9f 120%);
  --btn-shadow: 0 8px 22px rgba(0, 0, 0, .35);

  --shadow-sm: 0 1px 2px rgba(0, 0, 0, .3), 0 4px 12px rgba(0, 0, 0, .2);
  --shadow-md: 0 2px 6px rgba(0, 0, 0, .25), 0 14px 36px rgba(0, 0, 0, .32);
  --shadow-lg: 0 30px 90px rgba(0, 0, 0, .55), 0 2px 8px rgba(0, 0, 0, .3);

  --sky-a: #06131f;
  --sky-b: #0b2238;
  --sky-c: #123a52;
  --focus: 0 0 0 3px rgba(79, 209, 197, .38);
}

/* 2. BASE + TYPOGRAPHY ----------------------------------------------------- */
*, *::before, *::after { box-sizing: border-box; }

html, body {
  margin: 0;
  width: 100%;
  height: 100%;
}

html { -webkit-text-size-adjust: 100%; background: #cbeafa; }
html.dark { background: #0b2238; }

body {
  overflow: hidden;
  font-family: var(--font);
  font-size: var(--fs-base);
  line-height: var(--lh-body);
  color: var(--ink);
  background: transparent;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
  overscroll-behavior: none;
  -webkit-tap-highlight-color: transparent;
}

button, input, textarea, select { font: inherit; color: inherit; }
button { touch-action: manipulation; }
h1, h2, h3, p { margin: 0; }
a { color: var(--blue); }
::selection { background: rgba(20, 156, 148, .25); }

.hidden { display: none !important; }
.muted { color: var(--muted); }

.eyebrow {
  display: block;
  font-size: var(--fs-2xs);
  line-height: 1.3;
  letter-spacing: .14em;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--teal);
}

/* thin, quiet scrollbars */
* { scrollbar-width: thin; scrollbar-color: var(--line-strong) transparent; }
::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-thumb { background: var(--line-strong); border-radius: 10px; border: 3px solid transparent; background-clip: content-box; }
::-webkit-scrollbar-track { background: transparent; }

/* keyboard focus — visible, teal, never on mouse click */
:focus { outline: none; }
:focus-visible { outline: 2px solid var(--teal); outline-offset: 2px; border-radius: var(--r-sm); }
input:focus-visible, textarea:focus-visible { outline: none; }

/* 3. LIVE SKY (weather background) ------------------------------------------------
   Sky colours are animated custom properties; JS (WX engine) sets body.wx-<kind> and
   .wx-night / .wx-dusk. Clouds, rain, snow, fog and lightning are drawn on <canvas class="wx-canvas">. */
@property --sky-a { syntax: '<color>'; inherits: true; initial-value: #8fd0f5; }
@property --sky-b { syntax: '<color>'; inherits: true; initial-value: #cbeafa; }
@property --sky-c { syntax: '<color>'; inherits: true; initial-value: #f4fafe; }

.weather-scene {
  --sky-a: #8fd0f5; --sky-b: #cbeafa; --sky-c: #f4fafe;
  position: fixed; inset: 0; z-index: -2; overflow: hidden;
  background: linear-gradient(180deg, var(--sky-a) 0%, var(--sky-b) 55%, var(--sky-c) 100%);
  transition: --sky-a 2.6s ease, --sky-b 2.6s ease, --sky-c 2.6s ease;
}
.weather-scene::after {
  content: ""; position: absolute; inset: 0; pointer-events: none;
  background: radial-gradient(circle at 52% 14%, rgba(255, 255, 255, .55), transparent 42%), linear-gradient(180deg, transparent 60%, rgba(255, 255, 255, .28));
  transition: opacity 2s ease;
}
.wx-canvas { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }

/* --- daytime variants */
body.wx-clouds .weather-scene { --sky-a: #9fbccd; --sky-b: #d3e3eb; --sky-c: #eef5f8; }
body.wx-rain .weather-scene   { --sky-a: #71899a; --sky-b: #9db3bf; --sky-c: #d3dfe5; }
body.wx-storm .weather-scene  { --sky-a: #3b4f5e; --sky-b: #667d8c; --sky-c: #b3c3cc; }
body.wx-snow .weather-scene   { --sky-a: #a9c3d2; --sky-b: #dbe9f0; --sky-c: #f5fafc; }
body.wx-fog .weather-scene    { --sky-a: #b4c4cb; --sky-b: #d3dfe2; --sky-c: #eef2f3; }
body.wx-dusk .weather-scene   { --sky-a: #7ea4d6; --sky-b: #f0c3a6; --sky-c: #fbe8d6; }
body.wx-rain .weather-scene::after, body.wx-storm .weather-scene::after, body.wx-fog .weather-scene::after { opacity: .3; }

/* --- night (real night, or the dark theme) */
:is(html.dark body, body.wx-night) .weather-scene { --sky-a: #06131f; --sky-b: #0b2238; --sky-c: #123a52; }
:is(html.dark body.wx-clouds, body.wx-night.wx-clouds) .weather-scene { --sky-a: #0a1622; --sky-b: #14283a; --sky-c: #1c3a4d; }
:is(html.dark body.wx-rain, body.wx-night.wx-rain) .weather-scene { --sky-a: #070f18; --sky-b: #10202e; --sky-c: #1a3040; }
:is(html.dark body.wx-storm, body.wx-night.wx-storm) .weather-scene { --sky-a: #04080f; --sky-b: #0c1622; --sky-c: #16232f; }
:is(html.dark body.wx-snow, body.wx-night.wx-snow) .weather-scene { --sky-a: #0c1a28; --sky-b: #1a3044; --sky-c: #2a475c; }
:is(html.dark body.wx-fog, body.wx-night.wx-fog) .weather-scene { --sky-a: #0f1c28; --sky-b: #1d2f3d; --sky-c: #2c4352; }
:is(html.dark body, body.wx-night) .weather-scene::after {
  background: radial-gradient(circle at 60% 12%, rgba(79, 209, 197, .09), transparent 42%), linear-gradient(180deg, transparent 72%, rgba(79, 209, 197, .03));
}

/* --- stars, sun, moon travel across the sky with the real time of day */
.stars { position: absolute; inset: 0; opacity: 0; transition: opacity 2s; }
.stars::before, .stars::after {
  content: ""; position: absolute; inset: 0;
  background-image:
    radial-gradient(circle at 8% 14%, #fff 0 1px, transparent 1.8px), radial-gradient(circle at 19% 32%, rgba(255,255,255,.85) 0 1.4px, transparent 2px),
    radial-gradient(circle at 37% 10%, rgba(255,255,255,.65) 0 1px, transparent 1.7px), radial-gradient(circle at 54% 28%, rgba(255,255,255,.9) 0 1.2px, transparent 2px),
    radial-gradient(circle at 73% 13%, rgba(255,255,255,.7) 0 1.6px, transparent 2.2px), radial-gradient(circle at 88% 36%, rgba(255,255,255,.85) 0 1px, transparent 1.7px),
    radial-gradient(circle at 64% 45%, rgba(255,255,255,.55) 0 1px, transparent 1.8px), radial-gradient(circle at 28% 52%, rgba(255,255,255,.5) 0 1px, transparent 1.7px),
    radial-gradient(circle at 92% 8%, rgba(255,255,255,.7) 0 1px, transparent 1.7px), radial-gradient(circle at 46% 6%, rgba(255,255,255,.8) 0 1.2px, transparent 2px);
  animation: starDrift 30s ease-in-out infinite;
}
.stars::after { transform: scale(1.25); opacity: .4; animation-duration: 46s; animation-direction: reverse; }
:is(html.dark body, body.wx-night) .stars { opacity: 1; }
:is(html.dark body, body.wx-night):is(.wx-rain, .wx-storm, .wx-snow, .wx-fog) .stars { opacity: .18; }
:is(html.dark body, body.wx-night).wx-clouds .stars { opacity: .5; }

.sun {
  position: absolute; width: 200px; height: 200px; border-radius: 50%;
  left: calc(var(--sun-x, 82%) - 100px); top: calc(var(--sun-y, 14%) - 100px);
  background: radial-gradient(circle, #fff 0 10%, #fffbe9 24%, #ffe3a8 44%, rgba(255, 219, 141, .18) 68%, transparent 71%);
  box-shadow: 0 0 90px rgba(255, 220, 150, .5);
  opacity: .95;
  transition: left 4s ease, top 4s ease, opacity 2s ease;
  animation: sunFloat 12s ease-in-out infinite;
}
body.wx-clouds .sun { opacity: .5; }
body.wx-rain .sun, body.wx-storm .sun, body.wx-snow .sun, body.wx-fog .sun { opacity: 0; }
body.wx-dusk .sun { background: radial-gradient(circle, #fff 0 8%, #ffe2b8 22%, #ffb27a 42%, rgba(255, 150, 90, .22) 68%, transparent 71%); box-shadow: 0 0 130px rgba(255, 150, 90, .55); }
:is(html.dark body, body.wx-night) .sun { opacity: 0; }

.moon {
  position: absolute; width: 96px; height: 96px; border-radius: 50%;
  left: calc(var(--moon-x, 76%) - 48px); top: calc(var(--moon-y, 16%) - 48px);
  background: radial-gradient(circle at 35% 32%, #fff 0 18%, #e6f1f7 52%, #9db9cb 100%);
  box-shadow: 0 0 64px rgba(190, 228, 240, .45);
  opacity: 0;
  transition: left 4s ease, top 4s ease, opacity 2s ease;
}
:is(html.dark body, body.wx-night) .moon { opacity: .95; }
:is(html.dark body, body.wx-night):is(.wx-rain, .wx-storm, .wx-snow, .wx-fog) .moon { opacity: .12; }
:is(html.dark body, body.wx-night).wx-clouds .moon { opacity: .5; }

@keyframes starDrift { 50% { transform: translate3d(1.6%, 1.2%, 0) scale(1.02); } }
@keyframes sunFloat { 50% { transform: translate3d(0, 6px, 0); } }

/* 4. TOPBAR ---------------------------------------------------------------- */
.topbar {
  position: relative;
  z-index: 400;
  display: flex;
  align-items: center;
  gap: 12px;
  height: calc(var(--topbar-h) + var(--safe-t));
  padding: var(--safe-t) 24px 0;
}
.topbar-left { display: flex; align-items: center; min-width: 0; }
.top-nav { display: flex; align-items: center; gap: 2px; }

.top-nav-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  width: 64px;
  flex: 0 0 64px;
  height: 48px;
  padding: 0 4px;
  border: 0;
  border-radius: var(--r-md);
  background: transparent;
  color: var(--ink-2);
  font-size: var(--fs-2xs);
  font-weight: 600;
  letter-spacing: .01em;
  cursor: pointer;
  transition: background var(--t-fast), color var(--t-fast);
}
.top-nav-btn span { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.top-nav-btn:active { background: var(--chip-hover); }
.top-nav-svg {
  width: 22px; height: 22px;
  fill: none; stroke: currentColor; stroke-width: 1.7;
  stroke-linecap: round; stroke-linejoin: round;
}
html:not(.dark) .icon-moon, html.dark .icon-sun { display: none; }

.brand {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  font-size: 21px;
  line-height: 1;
  font-weight: 650;
  letter-spacing: -.01em;
  color: var(--navy);
  white-space: nowrap;
  pointer-events: auto;
  cursor: pointer;
}
html.dark .brand { color: var(--ink); }
.brand span {
  position: relative;
  display: inline-block;
  transition: transform .3s var(--ease), color .3s var(--ease);
}
.brand span::after {
  content: "";
  position: absolute; left: 0; right: 0; bottom: -3px;
  height: 2px; border-radius: 2px;
  background: var(--teal);
  transform: scaleX(0); transform-origin: 50% 50%;
  transition: transform .35s var(--ease);
}
@media (hover: hover) {
  .brand:hover span { transform: translateY(-2px); color: var(--teal); }
  .brand:hover span::after { transform: scaleX(1); }
  .brand span:nth-child(1)  { transition-delay: 0ms; }
  .brand span:nth-child(2)  { transition-delay: 18ms; }
  .brand span:nth-child(3)  { transition-delay: 36ms; }
  .brand span:nth-child(4)  { transition-delay: 54ms; }
  .brand span:nth-child(5)  { transition-delay: 72ms; }
  .brand span:nth-child(6)  { transition-delay: 90ms; }
  .brand span:nth-child(7)  { transition-delay: 108ms; }
  .brand span:nth-child(8)  { transition-delay: 126ms; }
  .brand span:nth-child(9)  { transition-delay: 144ms; }
  .brand span:nth-child(10) { transition-delay: 162ms; }
}

.top-actions { margin-left: auto; display: flex; align-items: center; gap: 4px; }
.live-pill {
  display: flex; align-items: center; gap: 6px;
  margin-right: 10px;
  font-size: var(--fs-2xs);
  font-weight: 700;
  letter-spacing: .12em;
  color: var(--muted);
}
.live-pill i, .status-dot {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--teal-2);
  box-shadow: 0 0 0 3px var(--teal-soft);
  animation: pulse 2.4s ease-in-out infinite;
}
@keyframes pulse { 50% { opacity: .45; transform: scale(.8); } }

.lang {
  width: 34px; height: 34px;
  border: 1px solid transparent;
  border-radius: var(--r-sm);
  background: transparent;
  font-size: 17px; line-height: 1;
  cursor: pointer;
  transition: background var(--t-fast), transform var(--t-fast) var(--ease), border-color var(--t-fast);
}
.lang:active { transform: scale(.9); }
.lang.active { background: var(--hover); border-color: var(--panel-border); box-shadow: var(--shadow-sm); }
.logout {
  margin-left: 6px;
  height: 34px;
  padding: 0 14px;
  white-space: nowrap;
  border: 0;
  border-radius: var(--r-sm);
  background: var(--chip);
  color: var(--ink-2);
  font-size: var(--fs-xs);
  font-weight: 600;
  cursor: pointer;
  transition: background var(--t-fast), transform var(--t-fast) var(--ease);
}
.logout:active { transform: scale(.95); }

@media (hover: hover) {
  .top-nav-btn:hover { background: var(--hover); color: var(--ink); }
  .lang:hover:not(.active) { background: var(--hover); }
  .logout:hover { background: var(--chip-hover); }
}

/* 5. HOME ------------------------------------------------------------------ */
.app-shell {
  position: relative;
  height: calc(100vh - var(--topbar-h) - var(--safe-t));
  height: calc(100dvh - var(--topbar-h) - var(--safe-t));
}
.home-view {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 24px 28px;
  overflow-y: auto;
  transition: opacity var(--t-base) var(--ease), transform var(--t-slow) var(--ease), visibility 0s;
}
/* home steps back while a window is open (no more ghosting behind panels) */
body.view-open .home-view {
  opacity: 0;
  transform: scale(.97);
  visibility: hidden;
  pointer-events: none;
  transition: opacity var(--t-base) var(--ease), transform var(--t-slow) var(--ease), visibility 0s linear var(--t-base);
}

.hero-copy { text-align: center; margin-bottom: 30px; }
.hero-copy .eyebrow { color: var(--ink-2); opacity: .8; }
.hero-copy h1 {
  margin: 10px 0 12px;
  font-size: var(--fs-hero);
  line-height: 1;
  font-weight: 650;
  letter-spacing: -.055em;
  color: var(--navy);
}
html.dark .hero-copy h1 { color: var(--ink); }
.hero-copy p { font-size: var(--fs-md); line-height: var(--lh-body); color: var(--ink-2); letter-spacing: -.01em; }

.quick-grid {
  width: min(880px, 100%);
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}
.service-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 16px;
  min-height: 108px;
  padding: 20px 56px 20px 22px;
  border: 1px solid var(--card-border);
  border-radius: var(--r-xl);
  background: var(--card);
  color: inherit;
  text-align: left;
  cursor: pointer;
  overflow: hidden;
  box-shadow: var(--shadow-md), inset 0 1px 0 rgba(255, 255, 255, .5);
  -webkit-backdrop-filter: blur(18px) saturate(140%);
  backdrop-filter: blur(18px) saturate(140%);
  transition: transform var(--t-base) var(--ease), box-shadow var(--t-base) var(--ease), border-color var(--t-base);
}
html.dark .service-card { box-shadow: var(--shadow-md), inset 0 1px 0 rgba(255, 255, 255, .06); }
.service-card::before {
  content: "";
  position: absolute;
  width: 150px; height: 150px;
  right: -60px; bottom: -84px;
  border-radius: 50%;
  background: var(--blue-soft);
  transition: transform var(--t-slow) var(--ease);
}
.service-main { border-color: rgba(43, 120, 168, .28); }
html.dark .service-main { border-color: rgba(99, 176, 220, .34); }
.service-card:active { transform: scale(.985); }

.service-icon {
  position: relative;
  flex: 0 0 48px;
  width: 48px; height: 48px;
  display: grid; place-items: center;
  border-radius: 15px;
  background: var(--blue-soft);
  color: var(--blue);
  transition: transform var(--t-base) var(--ease), background var(--t-base);
}
.service-icon svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
.icon-ai, .icon-news { background: var(--teal-soft); color: var(--teal); }

.service-text { position: relative; display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.service-text b { font-size: var(--fs-md); line-height: var(--lh-snug); letter-spacing: -.015em; font-weight: 650; }
.service-text small { font-size: var(--fs-sm); line-height: 1.45; color: var(--muted); }

.service-arrow {
  position: absolute;
  right: 20px; top: 50%;
  width: 20px; height: 20px;
  margin-top: -10px;
  color: var(--faint);
  transition: transform var(--t-base) var(--ease), color var(--t-base);
}
.service-arrow svg { width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

@media (hover: hover) {
  .service-card:hover { transform: translateY(-3px); border-color: rgba(43, 120, 168, .32); box-shadow: var(--shadow-lg); }
  .service-card:hover::before { transform: scale(1.6); }
  .service-card:hover .service-arrow { transform: translateX(4px); color: var(--blue); }
}

.home-status {
  width: min(880px, 100%);
  margin-top: 18px;
  display: flex; align-items: center; justify-content: center; flex-wrap: wrap;
  gap: 8px 20px;
  font-size: var(--fs-xs);
  color: var(--muted);
}
.home-status > div { display: flex; align-items: center; gap: 8px; }
.home-status > div:not(.home-currency):not(:first-child) { display: none; }
.wx-chip {
  padding: 8px 16px; border: 1px solid var(--card-border); border-radius: 999px;
  background: var(--card); box-shadow: var(--shadow-sm); color: var(--ink-2); font-size: var(--fs-sm); font-weight: 550;
  cursor: pointer; transition: transform var(--t-fast) var(--ease), box-shadow var(--t-base);
}
.wx-chip:active { transform: scale(.96); }
@media (hover: hover) { .wx-chip:hover { box-shadow: var(--shadow-md); } }
.home-currency {
  padding: 8px 16px;
  border: 1px solid var(--card-border);
  border-radius: 999px;
  background: var(--card);
  box-shadow: var(--shadow-sm);
  font-variant-numeric: tabular-nums;
}
.home-currency span { color: var(--muted); font-size: var(--fs-xs); }
.home-currency b { margin-right: 6px; font-size: var(--fs-md); font-weight: 650; color: var(--ink); letter-spacing: -.01em; }
.home-currency .home-currency-date {
  padding: 3px 9px;
  border-radius: 999px;
  background: var(--chip);
  font-weight: 600;
  color: var(--ink-2);
  cursor: pointer;
  transition: background var(--t-fast);
}
@media (hover: hover) { .home-currency .home-currency-date:hover { background: var(--chip-hover); } }

/* CBR historical-rate calendar popover */
.currency-cal {
  position: absolute;
  z-index: 1300;
  width: 272px;
  padding: 14px;
  border: 1px solid var(--panel-border);
  border-radius: var(--r-lg);
  background: var(--popover);
  box-shadow: var(--shadow-lg);
  -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px);
  opacity: 0; visibility: hidden; transform: translate3d(0, -6px, 0) scale(.97);
  transition: opacity var(--t-fast) var(--ease), transform var(--t-base) var(--ease), visibility 0s linear var(--t-base);
}
.currency-cal.open { opacity: 1; visibility: visible; transform: none; transition: opacity var(--t-fast) var(--ease), transform var(--t-base) var(--ease), visibility 0s; }
.cc-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; font-size: var(--fs-sm); font-weight: 650; }
.cc-nav { display: grid; place-items: center; width: 28px; height: 28px; border: 0; border-radius: 8px; background: var(--chip); color: var(--ink-2); cursor: pointer; }
.cc-nav svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
@media (hover: hover) { .cc-nav:hover { background: var(--chip-hover); } }
.cc-weekdays { display: grid; grid-template-columns: repeat(7, 1fr); margin-bottom: 4px; }
.cc-weekdays span { text-align: center; font-size: 10.5px; font-weight: 600; color: var(--muted); }
.cc-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; }
.cc-day {
  display: grid; place-items: center;
  height: 32px;
  border: 0; border-radius: 8px;
  background: transparent; color: var(--ink);
  font-size: 13px;
  cursor: pointer;
  transition: background var(--t-fast);
}
.cc-day.cc-empty { cursor: default; }
.cc-day.cc-disabled { color: var(--faint); cursor: default; }
.cc-day.cc-today { font-weight: 700; color: var(--teal); }
.cc-day.cc-selected { background: var(--btn); color: #fff; }
@media (hover: hover) { .cc-day:not(.cc-disabled):not(.cc-empty):not(.cc-selected):hover { background: var(--chip-hover); } }
.cc-today-btn {
  width: 100%; margin-top: 10px; height: 34px;
  border: 1px solid var(--line); border-radius: 999px;
  background: transparent; color: var(--ink-2);
  font-size: var(--fs-xs); font-weight: 600;
  cursor: pointer;
  transition: background var(--t-fast);
}
@media (hover: hover) { .cc-today-btn:hover { background: var(--chip); } }

/* one orchestrated entrance on load */
@keyframes rise { from { opacity: 0; transform: translate3d(0, 14px, 0); } to { opacity: 1; transform: none; } }
.hero-copy { animation: rise .7s var(--ease) backwards; }
.service-card { animation: rise .7s var(--ease) backwards; }
.quick-grid .service-card:nth-child(1) { animation-delay: .06s; }
.quick-grid .service-card:nth-child(2) { animation-delay: .11s; }
.quick-grid .service-card:nth-child(3) { animation-delay: .16s; }
.quick-grid .service-card:nth-child(4) { animation-delay: .21s; }
.home-status { animation: rise .7s var(--ease) .28s backwards; }

/* 6. VIEWS + PANELS -------------------------------------------------------- */
:root { --popover: #ffffff; }
html.dark { --popover: #12304b; }

.view-layer {
  position: absolute;
  inset: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 4px 24px 24px;
  overflow: hidden;
  visibility: hidden;
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--t-base) var(--ease), visibility 0s linear var(--t-base);
}
.view-layer.open {
  visibility: visible;
  opacity: 1;
  pointer-events: auto;
  transition: opacity var(--t-base) var(--ease), visibility 0s;
}

/* every window shares one surface */
.calculator-card, .directory-panel, .assistant-shell, .customs-shell, .agent-import-shell, .article-shell {
  --pw: 960px;
  --pt: 28px;
  --pb: 24px;
  --close-top: 14px;
  position: relative;
  display: flex;
  flex-direction: column;
  width: min(var(--pw), 100%);
  max-height: 100%;
  min-height: 0;
  padding: var(--pt) 32px var(--pb);
  overflow: hidden;
  border: 1px solid var(--panel-border);
  border-radius: var(--r-xl);
  background: var(--panel);
  box-shadow: var(--shadow-lg);
  -webkit-backdrop-filter: blur(24px) saturate(150%);
  backdrop-filter: blur(24px) saturate(150%);
  opacity: 0;
  transform: translate3d(0, 22px, 0) scale(.985);
  transition: transform var(--t-slow) var(--ease-sheet), opacity var(--t-base) var(--ease);
}
.view-layer.open > .calculator-card,
.view-layer.open > .directory-panel,
.view-layer.open > .assistant-shell,
.view-layer.open > .customs-shell,
.view-layer.open > .agent-import-shell,
.view-layer.open > .article-shell {
  opacity: 1;
  transform: none;
}
.calculator-card { --pw: 940px; overflow-y: auto; overscroll-behavior: contain; }
.calculator-card > *, .customs-shell > *, .agent-import-shell > * { flex-shrink: 0; }
.directory-panel { --pw: 1120px; }
.assistant-shell { --pw: 860px; height: min(100%, 820px); }
.customs-shell { --pw: 780px; overflow-y: auto; overscroll-behavior: contain; }
.agent-import-shell { --pw: 640px; overflow-y: auto; }
.article-shell { --pw: 1240px; --pt: 0px; --pb: 0px; height: 100%; padding: 0; overflow-y: auto; overscroll-behavior: contain; }

/* News list and article open truly full-screen: no floating card, edge to edge. */
#newsView, #articleView { padding: 0; }
#newsView .news-shell, #articleView .article-shell {
  --pw: 100vw;
  width: 100vw; height: 100%; max-height: 100%;
  border-radius: 0; border-width: 0;
  box-shadow: none;
}
#newsView .news-shell { padding: max(20px, calc(20px + var(--safe-t))) clamp(20px, 4vw, 64px) 28px; }
#articleView .article-shell { padding-top: var(--safe-t); }

/* close button — sticky, pinned top-right, takes no layout space */
.close-button {
  position: sticky;
  top: calc(var(--close-top) - var(--pt));
  z-index: 20;
  flex: 0 0 auto;
  align-self: flex-end;
  width: 36px; height: 36px;
  margin: calc(var(--close-top) - var(--pt)) -18px calc(var(--pt) - var(--close-top) - 36px) 0;
  padding: 0;
  display: grid; place-items: center;
  border: 0;
  border-radius: 50%;
  background: var(--chip);
  color: var(--ink-2);
  font-size: 0;
  cursor: pointer;
  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
  transition: background var(--t-fast), transform var(--t-fast) var(--ease), color var(--t-fast);
}
.close-button svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.close-button:active { transform: scale(.88); }
@media (hover: hover) { .close-button:hover { background: var(--chip-hover); color: var(--ink); } }
.agent-import-shell .close-button { align-self: flex-start; margin: calc(var(--close-top) - var(--pt)) 0 calc(var(--pt) - var(--close-top) - 36px) -18px; }
.article-shell .close-button { margin: 14px 14px -50px 0; top: 14px; background: rgba(6, 20, 34, .45); color: #fff; }

/* shared panel heading */
.directory-head h2, .assistant-head h2, .customs-head h2, .agent-import-shell h2, .calculator-card h1 {
  margin: 4px 0 6px;
  font-size: var(--fs-xl);
  line-height: var(--lh-tight);
  font-weight: 650;
  letter-spacing: -.03em;
  color: var(--ink);
}
.directory-head p, .assistant-head small, .customs-head p, .agent-import-shell p {
  display: block;
  font-size: var(--fs-base);
  line-height: var(--lh-body);
  color: var(--muted);
}
.directory-head, .assistant-head, .customs-head, .calculator-card h1 { padding-right: 44px; }
.calculator-card h1 { margin-bottom: 14px; }

/* 7. FORMS + CALCULATOR ---------------------------------------------------- */
.field { position: relative; display: flex; flex-direction: column; gap: 6px; min-width: 0; }
.field label { font-size: var(--fs-xs); font-weight: 600; line-height: 1.3; color: var(--ink-2); }
.dimension-unit-label { color: var(--muted); font-weight: 500; }

input, textarea {
  width: 100%;
  height: 42px;
  padding: 0 14px;
  border: 1px solid var(--field-border);
  border-radius: var(--r-md);
  background: var(--field);
  color: var(--ink);
  font-size: var(--fs-base);
  -webkit-appearance: none;
  appearance: none;
  transition: border-color var(--t-fast), box-shadow var(--t-fast), background var(--t-fast);
}
textarea { height: auto; padding: 12px 14px; line-height: 1.5; resize: none; }
input::placeholder, textarea::placeholder { color: var(--faint); opacity: 1; }
input:hover, textarea:hover { border-color: var(--line-strong); }
input:focus, textarea:focus { border-color: var(--teal); box-shadow: var(--focus); }
input[type="number"] { -moz-appearance: textfield; appearance: textfield; font-variant-numeric: tabular-nums; }
input[type="number"]::-webkit-inner-spin-button, input[type="number"]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
input[type="file"] { display: none; }

.route { display: grid; grid-template-columns: minmax(0, 1fr) 24px minmax(0, 1fr); gap: 12px; align-items: end; }
.route-arrow { display: grid; place-items: center; height: 42px; color: var(--faint); }
.route-arrow svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

.section-title, #dimensionsTitle {
  display: flex; align-items: center; gap: 12px;
  font-size: var(--fs-2xs); font-weight: 700; letter-spacing: .12em; line-height: 1.3;
  color: var(--muted);
}
.section-title { margin: 18px 0 8px; }
.section-title::after { content: ""; flex: 1; height: 1px; background: var(--line); }

.grid { display: grid; gap: 12px; }
.grid.three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.grid.four { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.grid.centered-three { grid-template-columns: repeat(3, minmax(0, 1fr)); }

.auto-calc-strip { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin: 10px 0; }
.auto-calc-strip > div {
  display: flex; align-items: baseline; justify-content: space-between; gap: 8px;
  padding: 9px 14px;
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  background: var(--blue-soft);
}
.auto-calc-strip span { font-size: var(--fs-xs); color: var(--muted); }
.auto-calc-strip b { font-size: var(--fs-md); font-weight: 650; letter-spacing: -.01em; font-variant-numeric: tabular-nums; }

.dimensions { margin: 0 0 12px; padding: 12px 14px 14px; border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--chip); }
.dimensions-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 8px; }

.container-warning, .terminal-warning {
  display: flex; align-items: flex-start; gap: 8px;
  margin-bottom: 10px; padding: 10px 12px;
  border-radius: var(--r-md);
  background: var(--warn-soft);
  color: var(--warn);
  font-size: 13.5px; line-height: 1.45; font-weight: 500;
}
.terminal-warning { margin: 12px 0 0; }
.ico { flex: 0 0 auto; width: 18px; height: 18px; margin-top: 1px; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; vertical-align: -3px; }
.ico.sm { width: 15px; height: 15px; margin: 0 4px 0 0; }

/* select-like dropdowns (click / tap) */
.hover-select { position: relative; }
.fake-select {
  width: 100%; height: 42px;
  display: flex; align-items: center; justify-content: space-between; gap: 8px;
  padding: 0 12px 0 14px;
  border: 1px solid var(--field-border);
  border-radius: var(--r-md);
  background: var(--field);
  font-size: var(--fs-base);
  text-align: left;
  cursor: pointer;
  transition: border-color var(--t-fast), box-shadow var(--t-fast);
}
.fake-select span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.fake-select .chev { flex: 0 0 auto; width: 18px; height: 18px; color: var(--muted); fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: transform var(--t-base) var(--ease); }
.fake-select:hover { border-color: var(--line-strong); }
.hover-select:has(.hover-menu.open) .fake-select { border-color: var(--teal); box-shadow: var(--focus); }
.hover-select:has(.hover-menu.open) .chev { transform: rotate(180deg); }

.hover-menu, .suggestions {
  position: absolute;
  left: 0; right: 0;
  z-index: 40;
  max-height: 264px;
  padding: 6px;
  overflow-y: auto;
  overscroll-behavior: contain;
  border: 1px solid var(--line-strong);
  border-radius: var(--r-md);
  background: var(--popover);
  box-shadow: var(--shadow-lg);
  opacity: 0;
  visibility: hidden;
  transition: opacity var(--t-fast) var(--ease), transform var(--t-base) var(--ease), visibility 0s linear var(--t-base);
}
.hover-menu { bottom: 48px; transform: translate3d(0, 6px, 0) scale(.98); transform-origin: 50% 100%; }
.suggestions { top: calc(100% + 6px); transform: translate3d(0, -6px, 0) scale(.98); transform-origin: 50% 0; }
.hover-menu.open, .suggestions.open { opacity: 1; visibility: visible; transform: none; transition: opacity var(--t-fast) var(--ease), transform var(--t-base) var(--ease), visibility 0s; }

.hover-item, .suggestions button {
  display: flex; flex-direction: column; align-items: flex-start; gap: 1px;
  width: 100%;
  padding: 10px 12px;
  border: 0; border-radius: var(--r-sm);
  background: transparent;
  color: var(--ink);
  font-size: 14px; line-height: 1.4; text-align: left;
  cursor: pointer;
  transition: background var(--t-fast);
}
.suggestions strong, .agent-option strong { font-weight: 600; }
.suggestions small { font-size: var(--fs-xs); color: var(--muted); }
.city-correction { font-size: var(--fs-xs); font-style: normal; color: var(--warn); }
.hover-item:active, .suggestions button:active { background: var(--chip-hover); }
@media (hover: hover) { .hover-item:hover, .suggestions button:hover { background: var(--blue-soft); } }

/* buttons */
.calculate, .assistant-save {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  height: 48px; padding: 0 24px;
  border: 0; border-radius: var(--r-md);
  background: var(--btn);
  color: #fff;
  font-size: var(--fs-base); font-weight: 650; letter-spacing: -.005em;
  box-shadow: var(--btn-shadow);
  cursor: pointer;
  transition: transform var(--t-fast) var(--ease), filter var(--t-fast), box-shadow var(--t-base) var(--ease);
}
#calculate { position: sticky; bottom: calc(12px - var(--pb)); z-index: 5; width: 100%; margin-top: 12px; box-shadow: 0 0 0 8px var(--panel), 0 -18px 16px 2px var(--panel), var(--btn-shadow); }
.calculate:active, .assistant-save:active { transform: scale(.985); filter: brightness(.95); }
.calculate[disabled], .assistant-save[disabled] { opacity: .55; cursor: default; box-shadow: none; }
.calculate.is-loading::before, .assistant-save.is-loading::before {
  content: ""; width: 16px; height: 16px;
  border: 2px solid rgba(255, 255, 255, .45); border-top-color: #fff; border-radius: 50%;
  animation: spin .7s linear infinite;
}
@media (hover: hover) { .calculate:hover, .assistant-save:hover { filter: brightness(1.07); box-shadow: 0 12px 26px rgba(37, 111, 159, .32); } }
@keyframes spin { to { transform: rotate(360deg); } }

.attach-button {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  height: 42px; padding: 0 16px;
  border: 0; border-radius: var(--r-md);
  background: var(--blue-soft); color: var(--blue);
  font-size: var(--fs-sm); font-weight: 600;
  cursor: pointer;
  transition: background var(--t-fast), transform var(--t-fast) var(--ease);
}
.attach-button:active { transform: scale(.94); }
.attach-button svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
.icon-only { width: 44px; padding: 0; }
@media (hover: hover) { .attach-button:hover { background: rgba(43, 120, 168, .17); } }

.rate-upload-area { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 12px; }
#rateUploadStatus { font-size: var(--fs-sm); color: var(--muted); }
#rateUploadStatus.is-ok { color: var(--ok); }
#rateUploadStatus.is-error { color: var(--danger); }

.recommendation {
  margin-top: 12px; padding: 12px 14px;
  border: 1px solid rgba(20, 156, 148, .2); border-radius: var(--r-md);
  background: var(--teal-soft);
  font-size: 14px; line-height: 1.5;
}
.route-advice { margin-top: 12px; }
.route-advice-main { display: flex; gap: 12px; padding: 14px; border: 1px solid var(--line); border-radius: var(--r-md); background: var(--blue-soft); }
.route-advice-icon { display: grid; place-items: center; flex: 0 0 34px; width: 34px; height: 34px; border-radius: 10px; background: var(--popover); color: var(--blue); }
.route-advice-icon .ico { margin: 0; }
.route-advice-text b { display: block; font-size: var(--fs-base); font-weight: 650; }
.route-advice-text p { margin: 2px 0 8px; font-size: 13.5px; line-height: 1.5; color: var(--ink-2); }
.route-advice-modes { display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: 13px; color: var(--ink-2); }
.route-advice-modes .ico { margin: 0 5px 0 0; color: var(--blue); }
.route-advice-warn { display: flex; gap: 10px; margin-top: 8px; padding: 11px 14px; border-radius: var(--r-md); font-size: 13.5px; line-height: 1.5; }
.route-advice-warn .route-advice-warn-icon { display: flex; }
.route-advice-danger { background: var(--danger-soft); color: var(--danger); }
.route-advice-warning { background: var(--warn-soft); color: var(--warn); }
.route-advice-info { background: var(--blue-soft); color: var(--ink-2); }

/* result */
.result { margin-top: 14px; }
.result-price-window { padding: 18px 20px; border: 1px solid var(--line-strong); border-radius: var(--r-lg); background: linear-gradient(135deg, var(--blue-soft), var(--teal-soft)); animation: rise .45s var(--ease) backwards; }
.result-price-window p { font-size: 14px; line-height: 1.55; color: var(--ink-2); }
.result-kicker { font-size: var(--fs-2xs); font-weight: 700; letter-spacing: .12em; color: var(--teal); }
.result-price { margin: 4px 0; font-size: 36px; line-height: 1.1; font-weight: 700; letter-spacing: -.035em; font-variant-numeric: tabular-nums; }
.result-price span { font-size: var(--fs-md); font-weight: 600; color: var(--muted); letter-spacing: 0; }
.result-price.muted { color: var(--faint); }
.result-meta { margin-bottom: 14px; font-size: 14px; color: var(--ink-2); }
.result-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
.result-grid span { display: flex; flex-direction: column; gap: 2px; padding: 10px 12px; border-radius: var(--r-sm); background: var(--field); font-size: var(--fs-xs); color: var(--muted); }
.result-grid b { font-size: var(--fs-base); font-weight: 650; color: var(--ink); font-variant-numeric: tabular-nums; }
.commission-note { margin-top: 12px; font-size: 13px; color: var(--ink-2); }
.result-notes { margin-top: 10px; font-size: 13px; line-height: 1.5; color: var(--muted); }
.result-loading { display: flex; align-items: center; gap: 10px; padding: 18px 20px; border-radius: var(--r-lg); background: var(--blue-soft); color: var(--ink-2); font-size: 14px; }
.result-loading::before { content: ""; width: 16px; height: 16px; border: 2px solid var(--line-strong); border-top-color: var(--teal); border-radius: 50%; animation: spin .7s linear infinite; }

.currency-bar { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 8px; margin-top: 14px; font-size: var(--fs-sm); color: var(--muted); font-variant-numeric: tabular-nums; }
