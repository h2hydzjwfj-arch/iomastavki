.article-audio-icon svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
.article-audio-text { flex: 1; min-width: 0; line-height: 1.35; }
.article-audio-title { font-size: var(--fs-base); font-weight: 650; }
.article-audio-sub { font-size: var(--fs-sm); color: var(--muted); }
.article-audio-btn {
  position: relative;
  display: inline-flex; align-items: center; gap: 8px;
  height: 44px; padding: 0 20px;
