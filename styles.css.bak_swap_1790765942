@media (hover: hover) { .btn-ghost:hover { background: var(--chip); } }
.article-sourcebox { margin-top: 40px; padding: 22px; border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--chip); font-size: 15px; line-height: 1.55; }
.article-sourcebox > div:first-child { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
.sb-label { font-size: var(--fs-2xs); font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
.article-sourcebox b { font-size: 17px; }
.sb-kind { padding: 3px 10px; border-radius: 999px; background: var(--teal-soft); color: var(--teal); font-size: var(--fs-xs); font-weight: 650; }
