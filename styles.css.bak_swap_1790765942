.ioma-orbit-ring{position:absolute;left:50%;top:50%;width:230%;height:230%;margin-left:-115%;margin-top:-115%;border-radius:50%;border:1px solid rgba(255,255,255,0.22);transform:rotate(-18deg) scaleY(0.32);pointer-events:none;opacity:0;transition:opacity .8s}
.ioma-orbit-moon{position:absolute;left:50%;top:50%;width:14px;height:14px;margin:-7px 0 0 -7px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#fff 0%,#cfd6e2 55%,#8c98ac 100%);box-shadow:0 0 14px rgba(200,225,255,0.8),0 0 4px rgba(255,255,255,0.95);pointer-events:none;opacity:0;transition:opacity .8s;animation:iomaOrbit 22s linear infinite}
html.dark .ioma-orbit-ring,html.dark .ioma-orbit-moon{opacity:1}
@keyframes iomaOrbit{0%{transform:rotate(0deg) translateX(115px) rotate(0deg)}100%{transform:rotate(360deg) translateX(115px) rotate(-360deg)}}
@keyframes iomaOrbitBoost{0%{transform:rotate(0deg) translateX(115px) rotate(0deg)}100%{transform:rotate(720deg) translateX(115px) rotate(-720deg)}}
.sun.boosting .ioma-orbit-moon,.moon.boosting .ioma-orbit-moon,.hero-sun.boosting .ioma-orbit-moon,.hero-moon.boosting .ioma-orbit-moon{animation:iomaOrbitBoost 1.7s cubic-bezier(.42,.05,.6,.95) !important}
@keyframes iomaPlanetPulse{0%{filter:brightness(1)}50%{filter:brightness(1.35)}100%{filter:brightness(1)}}
.sun.boosting,.moon.boosting,.hero-sun.boosting,.hero-moon.boosting{animation:iomaPlanetPulse 1.7s cubic-bezier(.42,.05,.6,.95) !important}
.sun,.moon,.hero-sun,.hero-moon{overflow:visible !important;position:relative !important}
