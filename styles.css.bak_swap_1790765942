.lang-switch-badge {
  position: fixed; top: calc(var(--safe-t) + 12px); left: 50%; z-index: 900;
  display: flex; align-items: center; gap: 8px;
  padding: 8px 14px; border-radius: 999px;
  background: var(--navy); color: #fff; font-size: var(--fs-sm);
  box-shadow: var(--shadow-md);
  opacity: 0; transform: translate3d(-50%, -12px, 0);
  transition: opacity var(--t-base) var(--ease), transform var(--t-base) var(--ease);
  pointer-events: none;
}
html.dark .lang-switch-badge { background: #1c4468; }
.lang-switch-badge.visible { opacity: 1; transform: translate3d(-50%, 0, 0); }
.lang-switch-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--teal-2); animation: pulse 1.2s ease-in-out infinite; }

/* 11. CUSTOMS -------------------------------------------------------------- */
