.news-card-body { padding: 14px 16px 16px; }
.news-card-meta { margin-bottom: 6px; font-size: var(--fs-xs); font-weight: 600; letter-spacing: .01em; color: var(--teal); }
.news-card-title {
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; line-clamp: 3; overflow: hidden;
  font-size: var(--fs-base); line-height: 1.4; font-weight: 600; letter-spacing: -.005em; color: var(--ink);
}
.news-card-important { border-color: rgba(201, 72, 63, .5); }
.news-card-badge {
  position: absolute; top: 12px; left: 12px; z-index: 2;
  padding: 4px 10px; border-radius: 999px;
  background: #c6433a; color: #fff;
  font-size: var(--fs-2xs); font-weight: 700; letter-spacing: .06em;
  box-shadow: 0 4px 12px rgba(198, 67, 58, .35);
}
@media (hover: hover) {
  .news-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); border-color: var(--line-strong); }
  .news-card:hover .news-card-img img { transform: scale(1.04); }
}
.news-loading { grid-column: 1 / -1; padding: 24px; text-align: center; color: var(--muted); }
.news-skeleton { border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--popover); overflow: hidden; }
.news-skeleton > .skeleton:first-child { height: 168px; border-radius: 0; }
.news-skeleton > div:last-child { display: grid; gap: 8px; padding: 14px 16px 18px; }
.news-skeleton > div:last-child .skeleton { height: 13px; }
.news-skeleton > div:last-child .skeleton:last-child { width: 62%; }

/* 10. ARTICLE -------------------------------------------------------------- */
.article-hero { position: relative; flex: 0 0 auto; height: clamp(300px, 50vh, 500px); overflow: hidden; background: linear-gradient(135deg, var(--blue), var(--navy)); }
.article-hero img { display: block; width: 100%; height: 100%; object-fit: cover; }
