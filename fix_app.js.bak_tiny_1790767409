    return out;
  }

  document.addEventListener('click', function(e){
    var btn = e.target.closest && e.target.closest('#themeToggleButton');
    if (!btn) return;
    var bodies = pickBodies();
    if (!bodies.length) return;

    bodies.forEach(function(el){
      el.classList.remove('celestial-flip-out','celestial-flip-in');
      void el.offsetWidth;
      el.classList.add('celestial-flip-out');
    });

    setTimeout(function(){
      bodies.forEach(function(el){
        el.classList.remove('celestial-flip-out');
        void el.offsetWidth;
        el.classList.add('celestial-flip-in');
        setTimeout(function(){ el.classList.remove('celestial-flip-in'); }, 400);
      });
    }, 360);
  }, true);
})();
