  function escapeHtml(s){
    return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
    });
  }

  // Простой markdown → HTML (жирный, курсив, списки, абзацы, заголовки)
  function mdToHtml(md){
    if (!md) return '';
    var lines = String(md).split(/\r?\n/);
    var html = [], buf = [], inList = false;
    function flushP(){
      if (buf.length){ html.push('<p>' + buf.join(' ') + '</p>'); buf = []; }
    }
    function flushList(){
      if (inList){ html.push('</ul>'); inList = false; }
    }
    lines.forEach(function(line){
      var t = line.trim();
      if (!t){ flushP(); flushList(); return; }
      var h = t.match(/^(#{1,6})\s+(.*)$/);
      if (h){ flushP(); flushList(); html.push('<h3>' + inline(h[2]) + '</h3>'); return; }
      var li = t.match(/^[-*•]\s+(.*)$/);
      if (li){
        flushP();
        if (!inList){ html.push('<ul>'); inList = true; }
        html.push('<li>' + inline(li[1]) + '</li>'); return;
      }
      buf.push(inline(t));
    });
    flushP(); flushList();
    return html.join('');
    function inline(s){
      return escapeHtml(s)
        .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
        .replace(/\*([^*]+)\*/g, '<em>$1</em>')
        .replace(/`([^`]+)`/g, '<code>$1</code>')
        .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1');
    }
  }

