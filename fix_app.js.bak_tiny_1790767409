(function(){
  if (window.__iomaParticles) return;
  window.__iomaParticles = { setWeather: function(){} };

  var canvas, ctx, dpr, W, H, raf;
  var mode = 'stars';   // stars | rain | snow | clouds | fog
  var particles = [];

  function initCanvas(){
    if (canvas) return;
    canvas = document.createElement('canvas');
    canvas.id = 'iomaParticlesCanvas';
    canvas.setAttribute('aria-hidden', 'true');
    Object.assign(canvas.style, {
      position: 'fixed',
      top: 0, left: 0,
      width: '100vw', height: '100vh',
      pointerEvents: 'none',
      zIndex: 1,
      opacity: 0,
      transition: 'opacity .8s ease'
    });
    document.body.appendChild(canvas);
    ctx = canvas.getContext('2d');
    resize();
    window.addEventListener('resize', resize);
  }
  function resize(){
    dpr = Math.max(1, Math.min(2, window.devicePixelRatio || 1));
    W = window.innerWidth;
    H = window.innerHeight;
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    rebuild();
  }

  function rebuild(){
    particles = [];
    // Много звёзд — плотное звёздное небо
    var n = Math.max(200, Math.min(600, Math.round(W / 3)));
    for (var i = 0; i < n; i++){
      // 15% крупных ярких звёзд
      var big = Math.random() < 0.15;
      particles.push({
        x: Math.random() * W,
        y: Math.random() * H,
        r: big ? (1.4 + Math.random() * 1.0) : (0.3 + Math.random() * 0.8),
        tw: Math.random() * Math.PI * 2,
        sp: 0.002 + Math.random() * 0.012,
        alpha: 0.4 + Math.random() * 0.6,
        big: big,
        // оттенок: голубоватые, белые, тёплые
        hue: Math.random() < 0.15 ? 'warm' : (Math.random() < 0.4 ? 'cool' : 'white')
      });
    }
  }

  function draw(){
    if (!ctx) return;
    ctx.clearRect(0, 0, W, H);

    for (var i = 0; i < particles.length; i++){
      var p = particles[i];
      p.tw += p.sp;
      var a = p.alpha * (0.35 + 0.65 * Math.abs(Math.sin(p.tw)));

      // Цвет по оттенку
      var col;
      if (p.hue === 'warm') col = 'rgba(255,240,210,' + a.toFixed(3) + ')';
      else if (p.hue === 'cool') col = 'rgba(200,220,255,' + a.toFixed(3) + ')';
      else col = 'rgba(255,255,255,' + a.toFixed(3) + ')';

      if (p.big){
        // Свечение вокруг крупной звезды
        var g = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.r * 5);
        g.addColorStop(0, col);
        g.addColorStop(0.35, 'rgba(255,255,255,' + (a * 0.5).toFixed(3) + ')');
        g.addColorStop(1, 'rgba(255,255,255,0)');
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r * 5, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.fillStyle = col;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fill();
    }

    if (isDark()) drawMeteors();
    raf = requestAnimationFrame(draw);
  }

  function start(){
    initCanvas();
    canvas.style.opacity = '1';
    if (!raf) draw();
  }
  function stop(){
    if (canvas) canvas.style.opacity = '0';
    if (raf){ cancelAnimationFrame(raf); raf = null; }
  }
  function isDark(){
    return document.documentElement.classList.contains('dark');
  }
  function tick(){
    if (isDark()) start(); else stop();
  }

  function pickModeByCode(code){
    // Только звёзды — никаких облаков, тумана, дождя и снега
    return 'stars';
  }

  window.__iomaParticles.setWeather = function(code, desc){
    meteors.length = 0;
    nextMeteorAt = Date.now() + 15000 + Math.random() * 12000;
    mode = pickModeByCode(code);
    if (ctx) rebuild();
    console.log('[particles] mode=' + mode + ' for code=' + code + ' (' + desc + ')');
  };

  // Следим за переключением темы
  var mo = new MutationObserver(tick);
  mo.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

  // Стартуем после загрузки
  function boot(){ tick(); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
})();

