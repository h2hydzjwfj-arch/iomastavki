(function(){
  if (window.__iomaCelestialFlip) return;
  window.__iomaCelestialFlip = true;

  function pickBodies(){
    var out = [];
    document.querySelectorAll('.sun, .moon, .hero-sun, .hero-moon, [class*="-sun"], [class*="-moon"]').forEach(function(el){
      if (el.closest('.top-nav-btn') || el.closest('.top-nav') || el.closest('#themeToggleButton') || el.closest('.top-actions')) return;
      if (el.classList.contains('ioma-orbit-ring') || el.classList.contains('ioma-orbit-moon')) return;
      out.push(el);
    });
    return out;
  }

  document.addEventListener('click', function(e){
    var btn = e.target.closest && e.target.closest('#themeToggleButton');
    if (!btn) return;

    // Все небесные тела, кроме иконки в шапке
    var oldBody = null;
    document.querySelectorAll('.sun, .moon, .hero-sun, .hero-moon').forEach(function(el){
      if (el.closest('.top-nav-btn') || el.closest('.top-nav') || el.closest('#themeToggleButton') || el.closest('.top-actions')) return;
      oldBody = el;
    });

    // 1) Текущее тело уезжает влево
    if (oldBody){
      oldBody.classList.remove('arriving', 'leaving');
      void oldBody.offsetWidth;
      oldBody.classList.add('leaving');
    }

    // 2) Через 0.55с — переключаем тему (тело меняется) и новое приезжает справа
    setTimeout(function(){
      // Тему переключает initTheme через свой обработчик; дадим ему сработать
      // А после этого найдём новое тело и запустим arriving
      setTimeout(function(){
        var newBody = null;
        document.querySelectorAll('.sun, .moon, .hero-sun, .hero-moon').forEach(function(el){
          if (el.closest('.top-nav-btn') || el.closest('.top-nav') || el.closest('#themeToggleButton') || el.closest('.top-actions')) return;
          newBody = el;
        });
        if (newBody){
          newBody.classList.remove('arriving', 'leaving');
          void newBody.offsetWidth;
          newBody.classList.add('arriving');
          setTimeout(function(){ newBody.classList.remove('arriving'); }, 600);
        }
        if (oldBody) oldBody.classList.remove('leaving');
      }, 30);
    }, 560);
  }, true);
})();

