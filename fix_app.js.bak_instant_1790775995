  function localizeCity(city, lang){
    if (!city) return city;
    if (lang === 'ru') return city;
    var m = CITY_I18N[city];
    return (m && m[lang]) || city;
  }
  function buildWeatherText(d, lang){
    if (!d || d.temp == null) return '';
    var dict = WMO_I18N[lang] || WMO_I18N.ru;
    var desc = dict[d.code] || dict[0] || '';
    var city = localizeCity(d.city, lang);
    var t = d.temp > 0 ? '+' + d.temp : String(d.temp);
    return city + ', ' + t + '°, ' + desc;
  }
  function formatDateI18n(dateStr, lang){
    if (!dateStr) return '';
    try {
      var loc = LOCALE[lang] || 'ru-RU';
      return new Date(dateStr).toLocaleDateString(loc);
    } catch(e){ return String(dateStr).slice(0,10); }
  }

  function loadRates(){
    fetch('/api/currency?t=' + Date.now(), { credentials:'same-origin', cache:'no-store' })
      .then(function(r){ return r.json(); })
