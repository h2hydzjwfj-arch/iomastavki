    if (ov) ov.hidden = true;
  }

  function run(){
    var q = String(document.getElementById('iomaAssistQ').value || '').trim();
    var out = document.getElementById('iomaAssistOut');
    var btn = document.getElementById('iomaAssistGo');
    if (!q){
      out.innerHTML = '<div class="ioma-assist-error">Введите вопрос клиента</div>';
      return;
    }
    out.innerHTML = '<div class="ioma-assist-loading"><div class="ioma-assist-spin"></div><span>Думаю над ответом…</span></div>';
    btn.disabled = true;
    fetch('/api/assist', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      credentials:'same-origin',
      body: JSON.stringify({ question: q })
    })
    .then(function(r){ return r.json().then(function(d){ return { s:r.status, d:d }; }); })
    .then(function(x){
      btn.disabled = false;
      if (!x.d || !x.d.ok){
        out.innerHTML = '<div class="ioma-assist-error">' + escapeHtml((x.d && x.d.error) || 'Ошибка') + '</div>';
        return;
      }
      var topics = (x.d.matchedTopics || []).map(function(t){ return escapeHtml(t.title); }).join(' · ');
      out.innerHTML = ''
        + '<div class="ioma-assist-result" id="iomaAssistResult">'
        +   '<button class="ioma-assist-copy" type="button" id="iomaAssistCopy">Скопировать</button>'
        +   (topics ? '<div class="ioma-assist-topics">Подобрано тем: <b>' + topics + '</b></div>' : '')
        +   escapeHtml(x.d.reply || '')
        + '</div>';
      document.getElementById('iomaAssistCopy').addEventListener('click', function(){
        var text = x.d.reply || '';
        navigator.clipboard.writeText(text).then(function(){
          var b = document.getElementById('iomaAssistCopy');
          b.textContent = 'Скопировано';
          b.classList.add('done');
          setTimeout(function(){ b.textContent = 'Скопировать'; b.classList.remove('done'); }, 1600);
        });
      });
    })
    .catch(function(e){
      btn.disabled = false;
      out.innerHTML = '<div class="ioma-assist-error">Ошибка соединения: ' + escapeHtml(e.message) + '</div>';
    });
  }

  // Кнопку в шапке больше НЕ создаём — используется карточка на главной
  // Открываем по клику на карточку "AI-ассистент" (data-open-view="assistant")
  document.addEventListener('click', function(e){
    var card = e.target.closest && e.target.closest('[data-open-view="assistant"]');
    if (card){
      e.preventDefault();
      e.stopImmediatePropagation();
      openModal();
    }
  }, true);

  window.iomaOpenAdminAssist = openModal;
  window.iomaOpenAssist = openModal;
})();

