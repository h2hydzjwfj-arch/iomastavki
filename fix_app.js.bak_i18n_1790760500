  function applyTranslations(lang){
    var dict = I18N[lang] || I18N.ru;
    var fb = I18N.ru;
    document.querySelectorAll('[data-i18n]').forEach(function(el){
      var k = el.getAttribute('data-i18n');
      var v = dict[k] !== undefined ? dict[k] : fb[k];
      if (v !== undefined) el.innerHTML = v;
    });
    document.querySelectorAll('[data-i18n-aria]').forEach(function(el){
      var k = el.getAttribute('data-i18n-aria');
      var v = dict[k] !== undefined ? dict[k] : fb[k];
      if (v) el.setAttribute('aria-label', v);
    });
    document.querySelectorAll('[data-i18n-title]').forEach(function(el){
      var k = el.getAttribute('data-i18n-title');
      var v = dict[k] !== undefined ? dict[k] : fb[k];
      if (v) el.setAttribute('title', v);
    });
    document.querySelectorAll('[data-i18n-placeholder]').forEach(function(el){
      var k = el.getAttribute('data-i18n-placeholder');
      var v = dict[k] !== undefined ? dict[k] : fb[k];
      if (v) el.setAttribute('placeholder', v);
    });
    document.documentElement.setAttribute('lang', lang);
    try { localStorage.setItem('ioma_lang', lang); } catch(e){}
  }

  function setLang(lang){
    applyTranslations(lang);
    document.querySelectorAll('.lang').forEach(function(b){
      b.classList.toggle('active', b.getAttribute('data-lang') === lang);
    });
  }
  window.setLang = setLang;
  window.translations = I18N;
  window.lang = 'ru';

  document.addEventListener('click', function(e){
    var b = e.target.closest && e.target.closest('.lang');
    if (!b) return;
    e.preventDefault();
    var l = b.getAttribute('data-lang');
    if (l) { window.lang = l; setLang(l); }
  });

  // ============ НОВОСТИ ============
  function escapeHtml(s){
    return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
    });
  }
  function formatDate(iso){
    if (!iso) return '';
    try {
      var d = new Date(iso);
      return d.toLocaleDateString('ru-RU', { day:'2-digit', month:'2-digit', year:'numeric' });
    } catch(e){ return ''; }
  }
  function renderNews(items){
    var el = document.getElementById('newsList');
    if (!el) return;
    if (!items || !items.length){
      el.innerHTML = '<div class="news-empty">Новости пока не загружены</div>';
      return;
    }
    el.innerHTML = items.map(function(it){
      var src = escapeHtml(it.source || '');
      var date = escapeHtml(formatDate(it.date));
      var title = escapeHtml(it.title || '');
      var desc = escapeHtml(it.description || '');
      var link = it.link ? escapeHtml(it.link) : '';
      var inner = ''
        + '<div class="news-item-head"><span class="news-item-source">' + src + '</span><span class="news-item-date">' + date + '</span></div>'
        + '<h3 class="news-item-title">' + title + '</h3>'
        + (desc ? '<p class="news-item-desc">' + desc + '</p>' : '');
      if (link) return '<a class="news-item" href="' + link + '" target="_blank" rel="noopener noreferrer">' + inner + '</a>';
      return '<div class="news-item">' + inner + '</div>';
    }).join('');
  }
  function loadNews(){
    var el = document.getElementById('newsList');
    if (!el) return;
    el.innerHTML = '<div class="news-loading">Загрузка…</div>';
    fetch('/api/news?t=' + Date.now(), { credentials:'same-origin', cache:'no-store' })
      .then(function(r){ return r.json(); })
      .then(function(d){ renderNews((d && d.items) || []); })
      .catch(function(e){
        el.innerHTML = '<div class="news-error">Не удалось загрузить новости</div>';
        console.warn('[news]', e);
      });
  }
  window.loadNews = loadNews;
  window.renderNews = renderNews;

  document.addEventListener('click', function(e){
    var b = e.target.closest && e.target.closest('[data-open-view="news"]');
    if (!b) return;
    setTimeout(loadNews, 50);
  }, false);

  // ============ КУРСЫ ============
  function loadRates(){
    fetch('/api/rates?t=' + Date.now(), { credentials:'same-origin', cache:'no-store' })
      .then(function(r){ return r.json(); })
      .then(function(d){
        var cny, usd, eur, date;
        if (d && (d.cny || d.usd || d.eur)) { cny=d.cny; usd=d.usd; eur=d.eur; date=d.date; }
        else if (d && d.rates) { cny=d.rates.cny; usd=d.rates.usd; eur=d.rates.eur; date=d.rates.date; }
        else if (d && Array.isArray(d.records)) {
          d.records.forEach(function(rec){
            var n = String(rec.company||rec.source||'').toUpperCase();
            if (/CNY/.test(n) && !cny) cny = rec.rate || rec.value;
            if (/USD/.test(n) && !usd) usd = rec.rate || rec.value;
            if (/EUR/.test(n) && !eur) eur = rec.rate || rec.value;
            if (!date && rec.updatedAt) date = rec.updatedAt;
          });
        }
        function setText(id, v){ var el=document.getElementById(id); if (el && v!=null) el.textContent = (typeof v==='number') ? v.toFixed(3) : v; }
        setText('homeCny', cny); setText('homeUsd', usd); setText('homeEur', eur);
        var dEl = document.getElementById('homeCurrencyDate');
        if (dEl && date) { try { dEl.textContent = new Date(date).toLocaleDateString('ru-RU'); } catch(e){ dEl.textContent = date; } }
      })
      .catch(function(e){ console.warn('[rates]', e); });
  }

  // ============ ПОГОДА ============
  function loadWeather(){
    fetch('/api/weather?t=' + Date.now(), { credentials:'same-origin', cache:'no-store' })
      .then(function(r){ return r.json(); })
      .then(function(d){
        var el = document.getElementById('homeWeatherText');
        if (!el || !d) return;
        if (d.ok && d.text) el.textContent = d.text;
        else if (d.temp != null) el.textContent = d.temp + '°C';
        else if (d.summary) el.textContent = d.summary;
      })
      .catch(function(e){ console.warn('[weather]', e); });
  }

  // ============ СТИЛИ НОВОСТЕЙ ============
  function injectStyles(){
    if (document.getElementById('iomaNewsStyles')) return;
    var st = document.createElement('style');
    st.id = 'iomaNewsStyles';
    st.textContent = ''
      + '.news-list{display:flex;flex-direction:column;gap:10px;padding:16px 0}'
      + '.news-item{display:block;padding:14px 16px;background:var(--card,#fff);border:1px solid rgba(0,0,0,.06);border-radius:14px;text-decoration:none;color:inherit;transition:transform .15s,box-shadow .15s}'
      + '.news-item:hover{transform:translateY(-1px);box-shadow:0 6px 20px rgba(0,0,0,.06)}'
      + '.news-item-head{display:flex;justify-content:space-between;font-size:12px;color:#889;margin-bottom:4px;gap:10px}'
      + '.news-item-title{margin:0 0 6px;font-size:15px;font-weight:600;line-height:1.35}'
      + '.news-item-desc{margin:0;font-size:13px;color:#556;line-height:1.45}'
      + '.news-loading,.news-empty,.news-error{padding:24px;text-align:center;color:#889}'
      + '.news-error{color:#c11}';
    document.head.appendChild(st);
  }

  // ============ INIT ============
  function init(){
    injectStyles();
    var saved = 'ru';
    try { saved = localStorage.getItem('ioma_lang') || 'ru'; } catch(e){}
    window.lang = saved;
    setLang(saved);
    var nv = document.getElementById('newsView');
    if (nv && nv.classList.contains('open')) loadNews();
    loadRates();
    loadWeather();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
